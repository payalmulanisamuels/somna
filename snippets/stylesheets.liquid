    var ZZ=`<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 8h7l-7 8h7'/><path d='M14 4h5l-5 5h5'/></svg>`;
    function benIcon(l){l=l.toLowerCase();if(l.indexOf('oxygen')>-1||l.indexOf('airflow')>-1)return AIR;if(l.indexOf('focus')>-1)return TGT;if(l.indexOf('sleep')>-1)return MOON;if(l.indexOf('snor')>-1)return ZZ;return AIR;}
    var cards=[].slice.call(hero.querySelectorAll('.spdp-bcard'));
    if(!cards.length)return;
    function byU(u){for(var i=0;i<cards.length;i++){if(Math.round(nA(cards[i],'data-units'))===u)return cards[i];}return cards[0];}
    var ord=cards.slice().sort(function(a,b){return nA(a,'data-units')-nA(b,'data-units');}).slice(0,3),badges=['','MOST POPULAR','BEST DEAL'];
    var D=ord.map(function(c,i){var sreg=nA(c,'data-sreg'),sf=nA(c,'data-sfirst'),u=Math.round(nA(c,'data-units'));return{name:(c.getAttribute('data-name')||'').replace('⭐','').replace(/,?\s*Get\s+(\d+)\s+Free/i,' + $1 Free').trim(),units:u,sreg:sreg,sf:sf,perday:u>0?sf/(u*30):0,once:nA(c,'data-onceprice'),plan:c.getAttribute('data-plan')||'',pct:sreg>0?Math.round((1-sf/sreg)*100):0,badge:badges[i]};});
    var titleEl=hero.querySelector('.spdp-h1jp'),title=titleEl?titleEl.textContent.trim():'';
    var bens=[].slice.call(hero.querySelectorAll('.spdp-jbl .spdp-jb')).map(function(el){return el.textContent.trim();}).filter(Boolean).slice(0,4);
