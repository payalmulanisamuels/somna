    jbs.forEach(function(jb,i){if(jb.querySelector('.hbi'))return;var s=document.createElement('span');s.className='hbi';s.innerHTML=ic[i%ic.length];jb.insertBefore(s,jb.firstChild);});
  }
  function splitNextgen(){
    var map={'Dynamic Lift Design':['Dynamic Lift','Design'],'Sweat-Proof Adhesive Matrix':['Sweat-Proof','Adhesive Matrix'],'40% More Airflow Per Breath*':['40% More Airflow','Per Breath*'],'40% More Airflow Per Breath':['40% More Airflow','Per Breath'],'40% More Oxygen Per Breath*':['40% More Oxygen','Per Breath*']};
    document.querySelectorAll('.shsng-feat > span').forEach(function(sp){if(sp.querySelector('.shsng-l2'))return;var t=(sp.textContent||'').trim();var parts=map[t];if(!parts){var w=t.split(' ');if(w.length<2)return;parts=[w.slice(0,-1).join(' '),w.slice(-1).join(' ')];}sp.innerHTML='<span class=shsng-l1>'+parts[0]+'</span><span class=shsng-l2>'+parts[1]+'</span>';});
