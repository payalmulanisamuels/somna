    if(!t)return;
    var brands=[[`Health`,'asi-serif'],[`The Oprah Magazine`,'asi-serif'],[`COSMOPOLITAN`,'asi-cosmo'],[`ELLE`,'asi-vogue'],[`goop`,'asi-goop'],[`Forbes`,'asi-forbes'],[`People`,'asi-forbes'],[`VOGUE`,'asi-vogue'],[`Women's Health`,'asi-cosmo']];
