    var giftEls=[].slice.call(hero.querySelectorAll('.spdp-gifts-row .spdp-gift'));
    var futEls=[].slice.call(hero.querySelectorAll('.spdp-fg-row .spdp-fg'));
    function grow(el,locked){var img=el?el.querySelector('img'):null,nm=el?((el.querySelector('b')||{}).textContent||''):'',em=el?el.querySelector('em'):null,val=em?em.textContent.trim():'';var right=val?`<s>${val}</s>FREE`:`FREE`;return `<div class='mbb-grow${locked?` mbb-locked`:``}'><span class=mbb-gim>${img?`<img src='${img.getAttribute('src')}' alt=''>`:``}</span><span class=mbb-gname>${nm}</span><span class=mbb-gval>${right}</span></div>`;}
    var giftsHtml='';
    if(giftEls[0])giftsHtml+=grow(giftEls[0],false);
    if(giftEls[1])giftsHtml+=grow(giftEls[1],false);
    giftsHtml+=`<div class=mbb-gdiv>Unlock with purchase of 3+</div>`;
    if(giftEls[2])giftsHtml+=grow(giftEls[2],true);
    if(futEls[0])giftsHtml+=grow(futEls[0],true);
    var checks=['Refill ships automatically','Adjust, skip or cancel anytime','FREE U.S. shipping'].map(function(t){return `<div class=mbb-check>${t}</div>`;}).join('');
    var onceMeta=(hero.querySelector('.spdp-oncemeta')||{}).textContent||'';
    var note=(hero.querySelector('.spdp-subvalue')||{}).textContent||'';
    var cardsHtml=D.map(function(d,i){var cls='mbb-card'+(i===0?' on mbb-cplain':(d.badge?' mbb-cpop':''));return `<div class='${cls}' data-i=${i}>${d.badge?`<span class=mbb-cbadge>${d.badge}</span>`:``}<span class=mbb-cname>${d.name}</span><span class=mbb-cprice><s>${money(d.sreg)}</s><b>${money(d.sf)}</b></span>${d.pct>0?`<span class=mbb-csave>SAVE ${d.pct}%</span>`:``}<span class=mbb-csupply>${money(d.perday)} / day</span></div>`;}).join('');
    var SHIELD=`<svg viewBox='0 0 24 24' fill='#0e0e16'><path d='M12 2l8 3v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V5l8-3z'/><path d='M8.6 11.8l2.2 2.2 4.4-4.6' fill='none' stroke='#fff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>`;
    var FLASK=`<svg viewBox='0 0 24 24' fill='none' stroke='#0e0e16' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M9 3h6'/><path d='M10 3.5v5.5l-4.7 7.8A2 2 0 0 0 7 20h10a2 2 0 0 0 1.7-3.2L14 9V3.5'/><path d='M8.5 14h7'/></svg>`;
    var mbb=document.createElement('div');mbb.id='somna-mbb';mbb.className='mbb';
    mbb.innerHTML=`<div class=mbb-rate><span class=st>★★★★★</span> Thousands of happy customers</div><div class=mbb-title>${title}</div><div class=mbb-benefits>${benHtml}</div><div class=mbb-label>Select your amount and unlock free gifts.</div><div class=mbb-cards>${cardsHtml}</div><div class=mbb-gifts><span class=mbb-gpill>Gifts Included</span>${giftsHtml}</div><div class=mbb-checks>${checks}</div><button class=mbb-cta type=button><span>Try Somna Today →</span></button><div class=mbb-trust><div class=mbb-trow>${SHIELD}<span>30 Days Risk-Free Money Back Guarantee</span></div><div class=mbb-trow>${FLASK}<span>All Somna products are 3rd party lab tested</span></div></div><a class=mbb-once href='#'></a><div class=mbb-oncemeta>${onceMeta}</div><div class=mbb-note>${note}</div>`;
    buy.insertBefore(mbb,hero);hero.style.display='none';
    var faq=buy.querySelector('.spdp-faq'),trust=mbb.querySelector('.mbb-trust');
    if(faq&&trust){trust.insertAdjacentElement('afterend',faq);}
    var IG=`<svg viewBox='0 0 24 24' fill='none' stroke='#DD2A7B' stroke-width='2'><rect x='3' y='3' width='18' height='18' rx='5'/><circle cx='12' cy='12' r='4'/><circle cx='17.5' cy='6.5' r='1.2' fill='#DD2A7B' stroke='none'/></svg>`;
    function findLoved(){var all=document.querySelectorAll('h1,h2,h3,h4,h5,h6,p,span,div,strong,b,em,li');var best=null,bn=1e9;for(var i=0;i<all.length;i++){var t=(all[i].textContent||'').replace(/\s+/g,' ').trim().toLowerCase();if(t.length>64)continue;if(t.indexOf('loved by')>-1&&(t.indexOf('athlete')>-1||t.indexOf('50k')>-1)){var n=all[i].getElementsByTagName('*').length;if(n<bn){bn=n;best=all[i];}}}return best;}
    var ighost=findLoved()||document.querySelector('.spdp-testi-h');
    if(ighost&&!document.getElementById('mbb-ig')){var iga=document.createElement('a');iga.id='mbb-ig';iga.className='mbb-igwrap-a';iga.href='https://www.instagram.com/';iga.target='_blank';iga.rel='noopener';iga.innerHTML=`<span class=mbb-igpill>${IG}<span>Over 500K Views On Instagram</span></span>`;ighost.insertAdjacentElement('afterend',iga);}
    var sel=0,mode='sub';
    var E={cards:[].slice.call(mbb.querySelectorAll('.mbb-card')),cta:mbb.querySelector('.mbb-cta'),once:mbb.querySelector('.mbb-once'),gifts:mbb.querySelector('.mbb-gifts'),checks:mbb.querySelector('.mbb-checks')};
    function render(){
      E.cards.forEach(function(c,i){c.classList.toggle('on',i===sel);});
      E.gifts.classList.toggle('unlocked',sel===2);
      var d=D[sel];
      if(mode==='sub'){E.gifts.style.display='';E.checks.style.display='';E.once.textContent='Try it Once for '+money(d.once);}
      else{E.gifts.style.display='none';E.checks.style.display='none';E.once.textContent='Switch to Subscription — 50% OFF first order';}
    }
    E.cards.forEach(function(c){c.addEventListener('click',function(){sel=parseInt(c.getAttribute('data-i'),10)||0;render();});});
    E.once.addEventListener('click',function(e){e.preventDefault();mode=(mode==='sub'?'once':'sub');render();});
    E.cta.addEventListener('click',function(){var d=D[sel],id=parseInt(variantId,10);if(!id){return;}var item={id:id,quantity:d.units};if(mode==='sub'&&d.plan)item.selling_plan=parseInt(d.plan,10);E.cta.style.opacity='.6';fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[item]})}).then(function(r){location.href='/cart';}).catch(function(){location.href='/cart';});});
    render();
  }
  function run(){try{asi();}catch(e){}try{nextgenPress();}catch(e){}try{buildMBB();}catch(e){}try{heroIcons();}catch(e){}try{splitNextgen();}catch(e){}}
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',run);}else{run();}
})();
</script>
