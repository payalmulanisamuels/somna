<script>
(function(){
  function mob(){return window.matchMedia&&window.matchMedia('(max-width:768px)').matches;}
  function vsCTA(){
    if(!mob())return;
    var sec=document.querySelector('.sjvs');if(!sec)return;
    if(sec.querySelector('.somna-vs-cta'))return;
    var wrap=sec.querySelector('.sjp-wrap')||sec;
    var d=document.createElement('div');d.className='somna-vs-cta';
    d.innerHTML=`<a class='sjp-cta' href='#cda-buy'>Try Somna Today →</a><div class='somna-vs-guar'><span class='somna-vs-ck'>✓</span>30-Day Feel-It Guarantee</div>`;
    wrap.appendChild(d);
  }
  function run(){try{vsCTA();}catch(e){}}
  if(document.readyState!=='loading')run();else document.addEventListener('DOMContentLoaded',run);
})();
</script>
