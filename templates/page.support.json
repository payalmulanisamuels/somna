        "q23": {
          "type": "faq",
          "settings": {
            "q": "I'm an athlete or content creator — how can I collaborate?",
            "a": "<p>We work with athletes, creators, and ambassadors across sports and wellness. Email collabs@somna.com with your platform handles, audience size, and a short pitch.</p>"
          }
        },
        "q24": {
          "type": "faq",
          "settings": {
            "q": "What does a partnership look like?",
            "a": "<p>Free product, custom discount codes for your audience, performance-based commissions, and feature opportunities on our channels.</p>"
          }
        },
        "q25": {
          "type": "faq",
          "settings": {
            "q": "How do I apply?",
            "a": "<p>Send your details to collabs@somna.com — we usually reply within 5 business days.</p>"
          }
        },
        "q26": {
          "type": "faq",
          "settings": {
            "q": "Do you offer an affiliate program?",
            "a": "<p>Yes — our affiliate program pays out a commission on every sale through your unique code. Apply by emailing collabs@somna.com.</p>"
          }
        },
