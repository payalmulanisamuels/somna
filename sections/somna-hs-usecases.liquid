{{ 'somna-hs-styles.css' | asset_url | stylesheet_tag }}
<section class="shs shs-sec shuc" style="background:{{ section.settings.bg | default: '#ffffff' }}">
  <div class="shs-wrap">
    <div class="somna-sr" style="text-align:center">
      {%- if section.settings.eyebrow != blank -%}<span class="shs-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="shuc-t">{{ section.settings.title | default: 'Better Nasal Flow Means' }}</h2>
    </div>
    <div class="shuc-row somna-sr-stag">
      {%- for block in section.blocks -%}
      <div class="shuc-card" {{ block.shopify_attributes }}>
        <div class="shuc-img">{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 700 }}" loading="lazy" alt="{{ block.settings.title | escape }}">{%- else -%}<div class="shuc-ph">Insert image (square)</div>{%- endif -%}</div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.body }}</p>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
.shuc-t{font-size:clamp(1.4rem,3.4vw,1.9rem);font-weight:700;letter-spacing:-.02em;margin:0 0 30px;color:var(--ink)}
.shuc-row{display:flex;gap:clamp(14px,2.5vw,26px);overflow-x:auto;scroll-snap-type:x proximity;padding-bottom:8px;-webkit-overflow-scrolling:touch}
.shuc-row::-webkit-scrollbar{height:6px}
.shuc-row::-webkit-scrollbar-thumb{background:#d6d6e0;border-radius:99px}
.shuc-card{flex:0 0 clamp(210px,23.5%,270px);scroll-snap-align:start;text-align:left}
.shuc-img{aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:#ECECF3}
.shuc-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1s cubic-bezier(.16,.84,.44,1)}
.shuc-card:hover .shuc-img img{transform:scale(1.04)}
.shuc-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#9a98b5;font-size:.78rem;text-align:center;padding:10px}
.shuc-card h3{font-size:1.02rem;font-weight:700;letter-spacing:-.015em;margin:14px 0 7px;color:var(--ink)}
.shuc-card p{font-size:.82rem;line-height:1.55;color:var(--mut);margin:0}
@media(max-width:700px){.shuc-card{flex:0 0 72%}}
</style>
{% schema %}
{
  "name": "HS — Use cases",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "title", "label": "Title", "default": "Better Nasal Flow Means" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [ { "type": "row", "name": "Card", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (square)" },
    { "type": "text", "id": "title", "label": "Title", "default": "Snore Less, Sleep Better" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Apply before bed to open nasal passages and unlock deeper, more restorative sleep." }
  ] } ],
  "max_blocks": 8,
  "presets": [{ "name": "HS — Use cases", "blocks": [ {"type":"row"},{"type":"row"},{"type":"row"},{"type":"row"} ] }]
}
{% endschema %}
