{{ 'clone-dreamx-alarm-styles.css' | asset_url | stylesheet_tag }}
<div class="dxs">
  {%- comment -%} ===== HERO ===== {%- endcomment -%}
  <section class="dxs-wrap dxs-sec">
    <div class="dxs-hero">
      <h1 class="dxs-h1">{{ section.settings.hero_h }}</h1>
      {% if section.settings.hero_sub != blank %}<p class="dxs-hsub">{{ section.settings.hero_sub }}</p>{% endif %}
      {% if section.settings.hero_stat != blank %}<div class="dxs-stat">{{ section.settings.hero_stat }}</div>{% endif %}
      <figure class="dxs-quote-single"><blockquote>{{ section.settings.q1 }}</blockquote>{% if section.settings.q1_a != blank %}<figcaption>— {{ section.settings.q1_a }}</figcaption>{% endif %}</figure>
      <div class="dxs-ctas">
        <a class="cda-btn dxs-btn dxs-btn-light" href="{{ section.settings.hero_cta_link | default: '/collections/all' }}">{{ section.settings.hero_cta }}</a>
        {% if section.settings.hero_cta2 != blank %}<a class="dxs-ghost dxs-ghost-light" href="{{ section.settings.hero_cta2_link | default: '/pages/the-science' }}">{{ section.settings.hero_cta2 }}</a>{% endif %}
      </div>
    </div>
  </section>

  {%- comment -%} ===== BUILT FOR SLEEP ===== {%- endcomment -%}
  <section class="dxs-wrap dxs-sec">
    <div class="dxs-split">
      <div>
        <h2 class="dxs-h2">{{ section.settings.b_h }}<br><span class="dxs-it">{{ section.settings.b_sub }}</span></h2>
        <p class="dxs-muted">{{ section.settings.b_body }}</p>
        <div class="dxs-list">{{ section.settings.b_list }}</div>
        {% if section.settings.b_cred != blank %}<div class="dxs-credline">{{ section.settings.b_cred }}</div>{% endif %}
        <a class="cda-btn dxs-btn" href="{{ section.settings.b_cta_link | default: '/collections/all' }}">{{ section.settings.b_cta }}</a>
      </div>
      {% if section.settings.img1 != blank %}<div class="cda-ph"><img src="{{ section.settings.img1 | image_url: width: 900 }}" alt="{{ section.settings.img1.alt }}" width="900" height="900" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="Lifestyle photo (1:1)"></div>{% endif %}
    </div>
  </section>

  {%- comment -%} ===== RESTLESS NIGHTS ===== {%- endcomment -%}
  <section class="dxs-wrap dxs-sec">
    <div class="dxs-split">
      {% if section.settings.img2 != blank %}<div class="cda-ph"><img src="{{ section.settings.img2 | image_url: width: 900 }}" alt="{{ section.settings.img2.alt }}" width="900" height="900" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="Lifestyle photo (1:1)"></div>{% endif %}
      <div>
        <span class="dxs-kick">{{ section.settings.r_sub }}</span>
        <h2 class="dxs-h2">{{ section.settings.r_h }}</h2>
        <p class="dxs-muted">{{ section.settings.r_body }}</p>
        <div class="dxs-list">{{ section.settings.r_list }}</div>
        {% if section.settings.r_rating != blank %}<div class="dxs-rating"><span class="dxs-stars">★★★★★</span> <span>{{ section.settings.r_rating }}</span></div>{% endif %}
        <div class="dxs-results">
          {% if section.settings.r_results_head != blank %}<div class="dxs-results-h">{{ section.settings.r_results_head }}</div>{% endif %}
          <ul class="dxs-results-list"><li>{{ section.settings.r_res1 }}</li><li>{{ section.settings.r_res2 }}</li><li>{{ section.settings.r_res3 }}</li></ul>
        </div>
        <a class="cda-btn dxs-btn" href="{{ section.settings.r_cta_link | default: '/pages/the-science' }}">{{ section.settings.r_cta }}</a>
      </div>
    </div>
  </section>

  {%- comment -%} ===== FOUNDER ===== {%- endcomment -%}
  <section class="dxs-wrap dxs-sec">
    <div class="dxs-founder">
      <div>
        <span class="dxs-kick">{{ section.settings.f_head }}</span>
        {% if section.settings.f_name != blank %}<div class="dxs-fname">{{ section.settings.f_name }}</div>{% endif %}
        {% if section.settings.f_creds != blank %}<div class="dxs-fcreds">{{ section.settings.f_creds }}</div>{% endif %}
        <p class="dxs-muted">{{ section.settings.f_story }}</p>
        {% if section.settings.f_quote != blank %}<p class="dxs-fquote">{{ section.settings.f_quote }}{% if section.settings.f_name != blank %}<span class="dxs-fquote-a"> — {{ section.settings.f_name }}</span>{% endif %}</p>{% endif %}
        {% if section.settings.f_cta != blank %}<a class="cda-btn dxs-btn" href="{{ section.settings.f_cta_link | default: '/pages/the-science' }}">{{ section.settings.f_cta }}</a>{% endif %}
      </div>
      {% if section.settings.img3 != blank %}<div class="cda-ph"><img src="{{ section.settings.img3 | image_url: width: 900 }}" alt="{{ section.settings.img3.alt }}" width="900" height="900" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="Founder / studio photo (1:1)"></div>{% endif %}
    </div>
  </section>

  {%- comment -%} ===== EMAIL ===== {%- endcomment -%}
  <section class="dxs-news"><div class="dxs-wrap dxs-news-in">
    <div><h2 class="dxs-h2" style="color:#fff">{{ section.settings.news_head }}</h2><p style="color:#eef0fb">{{ section.settings.news_sub }}</p></div>
    <form class="dxs-nform" onsubmit="return false">
      <div class="dxs-form"><input type="email" placeholder="E-mail"><button class="dxs-sub">{{ section.settings.news_btn }}</button></div>
      <label class="dxs-consent"><input type="checkbox"> <span>I agree to receive emails about sleep tips &amp; exclusive offers</span></label>
      {% if section.settings.news_proof != blank %}<div class="dxs-nproof">{{ section.settings.news_proof }}</div>{% endif %}
    </form>
  </div></section>

  {% if section.settings.disclaimer != blank %}<section class="dxs-wrap dxs-disc-sec"><p class="dxs-disc">{{ section.settings.disclaimer }}</p></section>{% endif %}
</div>
<style>
.dxs{font-family:var(--cda-font);color:var(--cda-ink)}
.dxs *{box-sizing:border-box}
.dxs-wrap{max-width:1120px;margin:0 auto;padding:0 clamp(16px,4vw,24px)}
.dxs-sec{padding:clamp(28px,5vw,54px) 0}
.dxs-hero{background:linear-gradient(150deg,#1a1726,#3a3f78);border-radius:24px;padding:clamp(32px,6vw,64px);color:#fff;text-align:center}
.dxs-h1{font-size:clamp(2.1rem,5vw,3.4rem);font-weight:800;letter-spacing:-.03em;margin:0 0 12px}
.dxs-h1 em{color:var(--cda-accent);font-style:italic}
.dxs-hsub{color:#dcdcf2;font-size:clamp(1rem,1.6vw,1.15rem);margin:0 auto 14px;max-width:54ch;line-height:1.5}
.dxs-stat{display:inline-block;color:#fff;font-weight:800;font-size:clamp(1rem,1.6vw,1.18rem);background:rgba(152,163,222,.22);border:1px solid rgba(152,163,222,.45);padding:8px 18px;border-radius:999px;margin-bottom:26px}
.dxs-quote-single{margin:0 auto 26px;max-width:62ch;position:relative;padding-top:30px}
.dxs-quote-single::before{content:'\201C';position:absolute;top:-4px;left:50%;transform:translateX(-50%);font-size:3.2rem;line-height:1;color:rgba(255,255,255,.3);font-family:Georgia,serif}
.dxs-quote-single blockquote{margin:0;color:#fff;font-size:clamp(1.05rem,2vw,1.3rem);font-style:italic;line-height:1.5;font-weight:500}
.dxs-quote-single figcaption{margin-top:12px;color:#c2c5e6;font-size:.9rem;font-weight:700}
.dxs-h2{font-size:clamp(1.55rem,3.4vw,2.3rem);font-weight:800;letter-spacing:-.02em;margin:0 0 14px}
.dxs-it{color:var(--cda-accent-d);font-style:italic;font-weight:700}
.dxs-muted{color:var(--cda-muted);margin:0 0 14px;line-height:1.65;font-size:1.02rem}
.dxs-list{margin:0 0 16px}
.dxs-list ul{list-style:none;margin:0;padding:0}
.dxs-list li{position:relative;padding:0 0 9px 20px;color:var(--cda-ink);font-weight:600;font-size:1rem;line-height:1.5}
.dxs-list li::before{content:'\2022';position:absolute;left:2px;top:-1px;color:var(--cda-accent-d);font-weight:800;font-size:1.1rem}
.dxs-credline{color:var(--cda-muted);font-weight:700;font-size:.86rem;margin:0 0 18px;letter-spacing:.01em}
.dxs-ctas{display:flex;align-items:center;gap:14px;flex-wrap:wrap;justify-content:center}
.dxs-btn{max-width:230px;min-height:48px;display:inline-flex;align-items:center;justify-content:center;background:var(--cda-accent);border:none}
.dxs-btn-light{max-width:240px}
.dxs-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 24px;border-radius:999px;border:1.5px solid var(--cda-line);color:var(--cda-ink);font-weight:700;text-decoration:none;font-size:.95rem}
.dxs-ghost-light{border-color:rgba(255,255,255,.7);color:#fff}
.dxs-ghost-light:hover{background:rgba(255,255,255,.12)}
.dxs-split{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
.dxs-split .dxs-ctas{justify-content:flex-start}
.dxs-kick{display:inline-block;text-transform:uppercase;letter-spacing:.14em;font-size:.72rem;font-weight:800;color:var(--cda-accent-d);margin-bottom:8px}
.dxs-rating{display:flex;align-items:center;gap:8px;font-weight:700;margin:8px 0 16px;color:var(--cda-ink);font-size:.95rem}
.dxs-stars{color:#f5a623;letter-spacing:1px}
.dxs-results{background:var(--cda-soft);border-radius:18px;padding:18px 20px;margin:0 0 18px}
.dxs-results-h{font-weight:800;font-size:.92rem;margin-bottom:10px;color:var(--cda-ink)}
.dxs-results-list{list-style:none;margin:0;padding:0;display:grid;gap:7px}
.dxs-results-list li{position:relative;padding-left:18px;font-weight:700;font-size:.92rem;color:var(--cda-accent-d);line-height:1.35}
.dxs-results-list li::before{content:'\2022';position:absolute;left:2px;top:-1px;font-size:1.1rem}
.dxs-founder{display:grid;grid-template-columns:1.1fr 1fr;gap:44px;align-items:center;background:#faf9ff;border:1px solid var(--cda-line);border-radius:24px;padding:clamp(24px,4vw,44px)}
.dxs-fname{font-weight:800;font-size:1.1rem;letter-spacing:-.01em}
.dxs-fcreds{color:var(--cda-muted);font-size:.86rem;font-weight:600;margin:2px 0 14px}
.dxs-fquote{font-style:italic;font-weight:700;font-size:1.15rem;color:var(--cda-accent-d);margin:12px 0 16px}
.dxs-fquote-a{color:var(--cda-muted);font-weight:600;font-size:.9rem;font-style:normal}
.dxs-news{background:var(--cda-accent);margin-top:14px}
.dxs-news-in{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:44px clamp(16px,4vw,24px);flex-wrap:wrap}
.dxs-nform{flex:1;max-width:460px;min-width:260px}
.dxs-form{display:flex;gap:10px}
.dxs-form input{flex:1;border:none;border-radius:999px;padding:15px 18px;font:inherit;min-height:48px;width:100%}
.dxs-sub{background:#fff;color:var(--cda-accent-d);border:none;border-radius:999px;padding:15px 24px;font-weight:700;cursor:pointer;min-height:48px;white-space:nowrap}
.dxs-consent{display:flex;align-items:center;gap:8px;margin-top:12px;color:#fff;font-size:.82rem;font-weight:500}
.dxs-consent input{width:16px;height:16px;flex:0 0 auto;accent-color:#fff}
.dxs-nproof{color:#eef0fb;font-size:.8rem;font-weight:600;margin-top:10px}
.dxs-disc-sec{padding:22px 0 40px}
.dxs-disc{color:var(--cda-muted);font-size:.72rem;line-height:1.5;max-width:80ch;margin:0 auto;text-align:center}
@media(max-width:820px){
  .dxs-split,.dxs-founder{grid-template-columns:1fr;gap:24px}
  .dxs-split .cda-ph{order:-1}
  .dxs-split .dxs-ctas{justify-content:stretch}
}
@media(max-width:560px){
  .dxs-sec{padding:22px 0}
  .dxs-hero{padding:26px 18px;border-radius:18px}
  .dxs-h1{font-size:clamp(1.75rem,8vw,2.2rem);margin:0 0 10px}
  .dxs-hsub{font-size:1rem;margin-bottom:12px}
  .dxs-stat{font-size:.86rem;padding:7px 14px;margin-bottom:20px}
  .dxs-quote-single{padding-top:26px;margin-bottom:22px}
  .dxs-quote-single blockquote{font-size:1.05rem}
  .dxs-h2{font-size:1.45rem;margin-bottom:10px}
  .dxs-muted{font-size:1rem;margin-bottom:12px}
  .dxs-list li{font-size:.96rem;padding-bottom:8px}
  .dxs-credline{font-size:.82rem;margin-bottom:14px}
  .dxs-btn,.dxs-ghost,.dxs-btn-light{width:100%;max-width:none}
  .dxs-ctas{flex-direction:column;align-items:stretch}
  .dxs-rating{font-size:.9rem}
  .dxs-results{padding:14px 16px}
  .dxs-results-list li{font-size:.92rem}
  .dxs-founder{padding:22px 18px;border-radius:18px}
  .dxs-fquote{font-size:1.08rem}
  .dxs-news{margin-top:16px}
  .dxs-news-in{flex-direction:column;align-items:stretch;text-align:left;padding:30px 18px}
  .dxs-nform{width:100%;max-width:none;min-width:0}
  .dxs-form{flex-direction:column}
  .dxs-sub{width:100%}
  .dxs-disc-sec{padding:18px 0 30px}
}
</style>
{% schema %}
{
  "name": "Somna Our Story",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_h", "label": "Headline", "default": "Why we sleep better" },
    { "type": "textarea", "id": "hero_sub", "label": "Subheadline", "default": "A complete sleep system designed for real sleep problems." },
    { "type": "text", "id": "hero_stat", "label": "Stat line (use a real, verifiable claim)", "default": "Trusted by thousands of sleepers · results you can feel" },
    { "type": "textarea", "id": "q1", "label": "Customer quote", "default": "A genuinely different way to wake up — tactile, calm, and quiet enough that no one else in the room ever knows." },
    { "type": "text", "id": "q1_a", "label": "Quote author (use a real customer)" },
    { "type": "text", "id": "hero_cta", "label": "Primary button", "default": "Shop our products" },
    { "type": "url", "id": "hero_cta_link", "label": "Primary button link" },
    { "type": "text", "id": "hero_cta2", "label": "Secondary button", "default": "Learn how it works" },
    { "type": "url", "id": "hero_cta2_link", "label": "Secondary button link" },
    { "type": "header", "content": "Built for sleep" },
    { "type": "text", "id": "b_h", "label": "Headline", "default": "Built for sleep." },
    { "type": "text", "id": "b_sub", "label": "Sub-headline (italic)", "default": "Backed by science." },
    { "type": "textarea", "id": "b_body", "label": "Body", "default": "Somna is a complete sleep system. Three products work together to help you breathe easier, stay asleep, and wake up gently — without waking your partner." },
    { "type": "richtext", "id": "b_list", "label": "What you get", "default": "<ul><li><strong>Nasal Strips:</strong> Open your airway. Breathe easier.</li><li><strong>Mouth Tape:</strong> Promote nasal breathing. Sleep deeper.</li><li><strong>Alarm Band:</strong> Wake gently. Wake only you.</li></ul>" },
    { "type": "text", "id": "b_cred", "label": "Credibility line (use real claims)", "default": "Doctor recommended  ·  Drug-free  ·  30-day guarantee" },
    { "type": "text", "id": "b_cta", "label": "Button", "default": "Start your sleep journey" },
    { "type": "url", "id": "b_cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "img1", "label": "Photo 1 (Built for Sleep)" },
    { "type": "header", "content": "From restless nights" },
    { "type": "text", "id": "r_h", "label": "Headline", "default": "From restless nights to calmer mornings" },
    { "type": "text", "id": "r_sub", "label": "Kicker", "default": "The Somna difference" },
    { "type": "textarea", "id": "r_body", "label": "Body", "default": "Most people struggle with sleep for years. Restless nights. Waking at 3 AM. Exhausted mornings. Somna goes after the root causes." },
    { "type": "richtext", "id": "r_list", "label": "Bullet list", "default": "<ul><li>Can't fall asleep? Nasal Strips help you breathe easier.</li><li>Waking at 3 AM? Mouth Tape keeps you asleep.</li><li>Can't wake up? The Alarm Band wakes only you.</li></ul>" },
    { "type": "text", "id": "r_rating", "label": "Social proof line (use real review data)", "default": "Loved by sleepers like you" },
    { "type": "text", "id": "r_results_head", "label": "Results headline", "default": "What customers report" },
    { "type": "text", "id": "r_res1", "label": "Result 1 (use real data)", "default": "Fall asleep more easily" },
    { "type": "text", "id": "r_res2", "label": "Result 2 (use real data)", "default": "Fewer night-time wake-ups" },
    { "type": "text", "id": "r_res3", "label": "Result 3 (use real data)", "default": "Wake up more refreshed" },
    { "type": "text", "id": "r_cta", "label": "Button", "default": "See how it works" },
    { "type": "url", "id": "r_cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "img2", "label": "Photo 2 (Restless Nights)" },
    { "type": "header", "content": "From our founder (add a real person)" },
    { "type": "text", "id": "f_head", "label": "Kicker", "default": "From our founder" },
    { "type": "text", "id": "f_name", "label": "Founder name (optional)" },
    { "type": "text", "id": "f_creds", "label": "Founder credentials (optional)" },
    { "type": "textarea", "id": "f_story", "label": "Founder story", "default": "We didn't build Somna to sell another gadget. We built it because too many people — students, nurses, parents, shift workers — were starting every day behind, woken by noise that disturbed everyone but them. We design for the quiet, repeatable wins: waking on time, breathing easier, recovering fully. Every product has to earn its place on your nightstand, night after night." },
    { "type": "text", "id": "f_quote", "label": "Founder quote", "default": "Sleep better. Wake quieter." },
    { "type": "text", "id": "f_cta", "label": "Button (optional)", "default": "Learn more about our science" },
    { "type": "url", "id": "f_cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "img3", "label": "Photo 3 (Founder)" },
    { "type": "header", "content": "Email capture" },
    { "type": "text", "id": "news_head", "label": "Headline", "default": "Get 15% off your first order" },
    { "type": "textarea", "id": "news_sub", "label": "Subline", "default": "Plus exclusive sleep science tips and early access to new products." },
    { "type": "text", "id": "news_btn", "label": "Button", "default": "Unlock my discount" },
    { "type": "text", "id": "news_proof", "label": "Social proof line", "default": "Join our growing community of better sleepers." },
    { "type": "header", "content": "Compliance" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "These statements have not been evaluated by the Food and Drug Administration. Somna products are not intended to diagnose, treat, cure, or prevent any disease or condition, including sleep apnea. They are designed to support healthy sleep habits. Individual results may vary. Always consult a healthcare professional about persistent sleep problems." }
  ],
  "presets": [{ "name": "Somna Our Story" }]
}
{% endschema %}
