</style>
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');if(!root)return;
  var opts=[].slice.call(root.querySelectorAll('[data-bundle]'));if(!opts.length)return;
  var state='sub';
  var els={supply:root.querySelector('[data-js-supply]'),badge:root.querySelector('[data-js-badge]'),price:root.querySelector('[data-js-price]'),was:root.querySelector('[data-js-was]'),then:root.querySelector('[data-js-then]'),perks:root.querySelector('[data-js-perks]'),gifts:root.querySelector('[data-js-gifts]'),ctawas:root.querySelector('[data-jb-ctawas]'),ctanow:root.querySelector('[data-jb-ctanow]')};
  var fgm=[].slice.call(root.querySelectorAll('[data-fg-month]'));
  function money(n){return '$'+(Math.round(n*100)/100).toFixed(2).replace(/\.00$/,'');}
  function num(el,attr){return parseFloat(el.getAttribute(attr))||0;}
  function curOpt(){return root.querySelector('[data-bundle].sel')||opts[0];}
  function badgePct(o){if(state==='sub'){var r=num(o,'data-sreg'),f=num(o,'data-sfirst');if(r>0&&f<r)return Math.round((1-f/r)*100);}else{var c=num(o,'data-compare'),p=num(o,'data-onceprice');if(c>0&&p<c)return Math.round((1-p/c)*100);}return 0;}
  function render(){
    opts.forEach(function(o){
      var cp=o.querySelector('[data-jb-cp]'),cw=o.querySelector('[data-jb-cw]'),bd=o.querySelector('[data-jb-badge]');
      var pct=badgePct(o);
      if(bd)bd.textContent=pct>0?('SAVE '+pct+'%'):'';
      if(state==='sub'){var r=num(o,'data-sreg'),f=num(o,'data-sfirst');if(cp)cp.textContent=money(f);if(cw)cw.textContent=(r>f)?money(r):'';}
      else{var c=num(o,'data-compare'),p=num(o,'data-onceprice');if(cp)cp.textContent=money(p);if(cw)cw.textContent=(c>p)?money(c):'';}
      var pl=o.getAttribute('data-plan');
      o.setAttribute('data-items',(state==='sub'&&pl)?(o.getAttribute('data-vid')+'|'+pl):o.getAttribute('data-vid'));
    });
    var o=curOpt();var pct=badgePct(o);
    var mu=Math.max(1,Math.round(num(o,'data-units')));
    fgm.forEach(function(el,i){el.textContent='Month '+(mu+1+i);});
    if(els.supply)els.supply.textContent=o.getAttribute('data-supply')||'';
    if(els.badge)els.badge.textContent=pct>0?('SAVE '+pct+'%'):'';
    var sreg=num(o,'data-sreg'),sfirst=num(o,'data-sfirst'),oncep=num(o,'data-onceprice'),comp=num(o,'data-compare');
    if(state==='sub'){
      if(els.price)els.price.textContent=money(sfirst);
      if(els.was)els.was.textContent=(sreg>sfirst)?money(sreg):'';
      if(els.then)els.then.textContent=money(sfirst)+' today. Then '+money(sreg)+' every '+(mu*30)+' days.';
      if(els.perks)els.perks.style.display='';
      if(els.gifts)els.gifts.style.display='';
      if(els.ctawas)els.ctawas.textContent=(sreg>sfirst)?money(sreg):'';
      if(els.ctanow)els.ctanow.textContent=money(sfirst);
    }else{
      if(els.price)els.price.textContent=money(oncep);
      if(els.was)els.was.textContent=(comp>oncep)?money(comp):'';
      if(els.then)els.then.textContent='One-time purchase · No recurring deliveries';
      if(els.perks)els.perks.style.display='none';
      if(els.gifts)els.gifts.style.display='none';
      if(els.ctawas)els.ctawas.textContent=(comp>oncep)?money(comp):'';
      if(els.ctanow)els.ctanow.textContent=money(oncep);
    }
    var sp=root.querySelector('[data-spsb-stickyprice]');if(sp)sp.textContent=(state==='sub'?money(sfirst):money(oncep));
    var sn=root.querySelector('[data-spsb-stickyname]');if(sn)sn.textContent=(o.getAttribute('data-name')||'')+' · '+(state==='sub'?'Subscription':'One-time');
    var tg=root.querySelector('[data-jb-toggle]');if(tg){tg.textContent=tg.getAttribute('data-once-label')+' ('+money(oncep)+')';}
  }
  opts.forEach(function(o){o.addEventListener('click',function(e){e.preventDefault();opts.forEach(function(x){x.classList.remove('sel');});o.classList.add('sel');render();});});
  function addOnce(trigger){
    var o=curOpt();var id=parseInt(o.getAttribute('data-vid'),10);if(!id)return;
    if(window.SomnaCart&&window.SomnaCart.add){window.SomnaCart.add([{id:id,quantity:1}],{openDrawer:true,trigger:trigger||null});return;}
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:id,quantity:1}]})}).then(function(r){if(!r.ok)throw 0;window.location.href='/cart';}).catch(function(){window.location.href='/cart';});
  }
  var tg=root.querySelector('[data-jb-toggle]');
  if(tg)tg.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();addOnce(tg);});
  var sb=root.querySelector('[data-jb-shipsby]');
  if(sb){var d=new Date(Date.now()+86400000);var mo=d.toLocaleString('en-US',{month:'long'});var day=d.getDate();var v=day%100;var suf=(v>=11&&v<=13)?'th':({1:'st',2:'nd',3:'rd'}[day%10]||'th');sb.textContent=mo+' '+day+suf;}
  function addToCart(){
    var o=curOpt();var id=parseInt(o.getAttribute('data-vid'),10);if(!id)return;
    var item={id:id,quantity:1};
    var plan=o.getAttribute('data-plan');
    if(state==='sub'&&plan)item.selling_plan=parseInt(plan,10);
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[item]})}).then(function(r){if(!r.ok)throw 0;window.location.href='/cart';}).catch(function(){window.location.href='/cart';});
  }
  var cta=root.querySelector('[data-jb-atc]');
  if(cta)cta.addEventListener('click',function(){if(window.SomnaCart)return;addToCart();});
  var scta=document.getElementById('{{ fid }}-stickycta');
  if(scta)scta.addEventListener('click',function(){if(window.SomnaCart)return;addToCart();});
  var ssel=root.querySelector('[data-spsb-stickysel]'),smenu=root.querySelector('[data-spsb-stickymenu]');
  if(ssel&&smenu){opts.forEach(function(o,i){var mi=document.createElement('button');mi.type='button';mi.className='spdp-smenu-i';mi.textContent=(o.getAttribute('data-name')||('Option '+(i+1)));mi.addEventListener('click',function(e){e.preventDefault();opts.forEach(function(x){x.classList.remove('sel');});o.classList.add('sel');render();smenu.classList.remove('open');});smenu.appendChild(mi);});ssel.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();smenu.classList.toggle('open');});document.addEventListener('click',function(e){if(ssel.contains(e.target)||smenu.contains(e.target))return;smenu.classList.remove('open');});}
  var stick=root.querySelector('[data-spsb-sticky]');
  var bx=document.getElementById('{{ fid }}-box');
  if(stick&&bx){
    var sticking=null;
    var stickCheck=function(){var r=bx.getBoundingClientRect();var show=r.bottom<0;if(show!==sticking){sticking=show;stick.classList.toggle('on',show);}};
    window.addEventListener('scroll',stickCheck,{passive:true});
    window.addEventListener('resize',stickCheck,{passive:true});
    setInterval(stickCheck,600);
    stickCheck();
  }else if(stick){stick.classList.add('on');}
  render();
})();
</script>
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');if(!root)return;
  var box=document.getElementById('{{ fid }}-main');var main=box?box.querySelector('img'):null;
  var th=[].slice.call(root.querySelectorAll('[data-spsb-thumb],[data-spdp-thumb]'));
  var navs=root.querySelectorAll('.spdp-gnav');
  if(!main||th.length<2){for(var k=0;k<navs.length;k++)navs[k].style.display='none';return;}
  var urls=th.map(function(t){return t.getAttribute('data-spsb-thumb')||t.getAttribute('data-spdp-thumb');});
  var idx=0;
  function setA(){th.forEach(function(t,j){t.classList.toggle('sel',j===idx);});}
  function show(i){idx=(i+urls.length)%urls.length;main.src=urls[idx];setA();}
  th.forEach(function(t,i){t.addEventListener('click',function(){main.src=urls[i];idx=i;setA();});});
  var pa=root.querySelector('[data-gprev]'),na=root.querySelector('[data-gnext]');
  if(pa)pa.addEventListener('click',function(e){e.preventDefault();show(idx-1);});
  if(na)na.addEventListener('click',function(e){e.preventDefault();show(idx+1);});
  var sx=null;
  box.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
  box.addEventListener('touchend',function(e){if(sx==null)return;var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40)show(dx<0?idx+1:idx-1);sx=null;},{passive:true});
  setA();
})();
</script>
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');if(!root)return;
  var vids=[].slice.call(root.querySelectorAll('.spdp-tv'));if(!vids.length)return;
  vids.forEach(function(v){
    var card=v.parentNode;var btn=card.querySelector('.spdp-tgo');
    var prime=function(){if(v.hasAttribute('poster'))return;try{if(v.currentTime===0)v.currentTime=0.05;}catch(e){}};
    if(v.readyState>=1)prime();else v.addEventListener('loadedmetadata',prime);
    function start(){
      vids.forEach(function(o){if(o!==v&&!o.paused){o.pause();var ob=o.parentNode.querySelector('.spdp-tgo');if(ob)ob.style.display='';}});
      v.setAttribute('controls','');
      if(btn)btn.style.display='none';
      var p=v.play();if(p&&p.catch)p.catch(function(){});
    }
    if(btn)btn.addEventListener('click',function(e){e.stopPropagation();start();});
    v.addEventListener('click',function(){if(!v.hasAttribute('controls'))start();});
    v.addEventListener('ended',function(){v.removeAttribute('controls');v.currentTime=0.05;if(btn)btn.style.display='';});
  });
})();
</script>
