{{ 'clone-dreamx-alarm-styles.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap">
{%- assign cur = product.selected_or_first_available_variant -%}
{%- assign fid = 'spsb-' | append: section.id -%}
{%- assign vm = product.variants[0] -%}
{%- assign bdg = section.settings.badge_color | default: '#5B79F3' -%}
<section class="cda-section spdp" id="cda-buy"><div class="cda-wrap"><div class="spdp-grid">
  <div class="spdp-media">
    {%- if product.media.size > 0 -%}
      <div class="spdp-main cda-ph" id="{{ fid }}-main"><img src="{{ product.featured_media | image_url: width: 1100 }}" alt="{{ product.title | escape }}" width="1100" height="1100" loading="eager"><button type="button" class="spdp-gnav spdp-gnav-l" data-gprev aria-label="Previous image">‹</button><button type="button" class="spdp-gnav spdp-gnav-r" data-gnext aria-label="Next image">›</button>{% if section.settings.hero_badge != blank %}<span class="spdp-hbadge">{{ section.settings.hero_badge }}</span>{% endif %}</div>
      <div class="spdp-thumbs">{%- for m in product.media limit: 9 -%}{%- unless forloop.first -%}<button class="cda-ph" data-spsb-thumb="{{ m | image_url: width: 1100 }}"><img src="{{ m | image_url: width: 400 }}" alt="" width="400" height="400" loading="lazy"></button>{%- endunless -%}{%- endfor -%}</div>
    {%- else -%}
      <div class="spdp-main cda-ph" id="{{ fid }}-main" data-label="Main image"></div>
      <div class="spdp-thumbs"><div class="cda-ph" data-label="1:1"></div><div class="cda-ph" data-label="1:1"></div><div class="cda-ph" data-label="1:1"></div><div class="cda-ph" data-label="1:1"></div></div>
    {%- endif -%}
  {% if section.settings.enable_review %}
    {%- if section.settings.rev_title != blank or section.settings.rev_quote != blank -%}
    <div class="spdp-revcard">
      <div class="spdp-rev-l">
        {%- if section.settings.rev_img != blank -%}<img src="{{ section.settings.rev_img | image_url: width: 160 }}" loading="lazy" alt="{{ section.settings.rev_name | escape }}">{%- else -%}<span class="spdp-rev-avph">😊</span>{%- endif -%}
        <b>{{ section.settings.rev_name | default: 'Customer name' }}</b>
        <span>{{ section.settings.rev_sub | default: 'VERIFIED CUSTOMER' }}</span>
      </div>
      <div class="spdp-rev-r">
        <div class="spdp-rev-top"><span class="cda-stars">★★★★★</span><b>{{ section.settings.rev_title }}</b></div>
        {%- if section.settings.rev_quote != blank -%}<p>{{ section.settings.rev_quote }}</p>{%- endif -%}
      </div>
    </div>
    {%- endif -%}
    {%- endif -%}
  </div>
  <div class="spdp-buy">
    <div class="spdp-herocard" data-jstate="sub" id="{{ fid }}-box">
    <h1 class="spdp-h1jp">{{ section.settings.head_a }} {{ section.settings.head_b }}</h1>
    <div class="spdp-rate"><span class="cda-muted spdp-ratemeta"> {% if section.settings.meta != blank %}  {{ section.settings.meta }}{% endif %}</span></div>
    <div class="spdp-sub">{{ section.settings.subhead }}</div>
    {%- assign checks = section.settings.checks | newline_to_br | split: '<br />' -%}
    <div class="spdp-jbl">{%- for c in checks -%}{%- assign ct = c | strip -%}{% if ct != '' %}<div class="spdp-jb">{{ ct }}</div>{% endif %}{%- endfor -%}</div>
    <div class="spdp-label">{{ section.settings.plan_label | default: 'Choose your bundle:' }}</div>
    <div class="spdp-bwrap" id="{{ fid }}-opts">
      {%- assign first_b = true -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'bundle' -%}
        {%- assign btitle = block.settings.title | remove: '⭐' | strip -%}
        {%- assign vp = block.settings.vpos | default: '1' | plus: 0 -%}
        {%- assign vidx = vp | minus: 1 -%}
        {%- assign v = product.variants[vidx] | default: product.variants.first -%}
        {%- assign want_plan = block.settings.plan_id | plus: 0 -%}
        {%- assign sfirst = v.price -%}
        {%- assign planid = '' -%}
        {%- for al in v.selling_plan_allocations -%}
          {%- if want_plan > 0 -%}
            {%- if al.selling_plan.id == want_plan -%}{%- assign sfirst = al.price -%}{%- assign planid = al.selling_plan.id -%}{%- endif -%}
          {%- elsif forloop.first -%}
            {%- assign sfirst = al.price -%}{%- assign planid = al.selling_plan.id -%}
          {%- endif -%}
        {%- endfor -%}
        {%- comment -%} One-time price shown = 60% of variant price: matched by the automatic "One-time purchase — 40% off Nasal Strips" discount, so displayed = charged. {%- endcomment -%}
        <label class="spdp-bcard{% if first_b %} sel{% endif %}" data-bundle data-vid="{{ v.id }}" data-items="{{ v.id }}{% if planid != blank %}|{{ planid }}{% endif %}" data-units="{{ block.settings.units | default: '1' }}" data-sreg="{{ v.price | divided_by: 100.0 }}" data-sfirst="{{ sfirst | divided_by: 100.0 }}" data-onceprice="{{ v.price | times: 0.6 | divided_by: 100.0 }}" data-compare="{{ v.compare_at_price | default: 0 | divided_by: 100.0 }}" data-plan="{{ planid }}" data-name="{{ btitle | escape }}" data-supply="{{ block.settings.supply | escape }}" {{ block.shopify_attributes }}>
          {%- if block.settings.popular -%}<span class="spdp-pop">{{ block.settings.popular_label | default: 'MOST POPULAR' }}</span>{%- endif -%}
          {%- if block.settings.image != blank -%}
          <span class="spdp-bimg"><img src="{{ block.settings.image | image_url: width: 240 }}" alt=""></span>
          {%- else -%}
          <span class="spdp-bth">{%- if v.featured_image -%}<img src="{{ v.featured_image | image_url: width: 120 }}" alt="">{%- elsif product.featured_media -%}<img src="{{ product.featured_media | image_url: width: 120 }}" alt="">{%- endif -%}</span>
          {%- endif -%}
          <span class="spdp-bcopy"><span class="spdp-bt">{{ btitle }}<i class="spdp-bsave" data-jb-badge></i></span><span class="spdp-bs">{{ block.settings.supply }}</span></span>
          <span class="spdp-bp"><b data-jb-cp></b><s data-jb-cw></s></span>
        </label>
        {%- assign first_b = false -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="spdp-sum" id="{{ fid }}-sum">
      <div class="spdp-sum-top"><span class="spdp-sum-radio"></span><span class="spdp-sum-supply" data-js-supply></span>
      <span class="spdp-bsave spdp-sum-badge" data-js-badge></span>
    </div>
      <div class="spdp-sum-price"><b data-js-price></b><s data-js-was></s></div>
      <div class="spdp-sum-then" data-js-then style="display:none"></div>
      <ul class="spdp-sum-perks" data-js-perks>
        {%- assign perks = section.settings.perks | newline_to_br | split: '<br />' -%}
        {%- for p in perks -%}{%- assign pt = p | strip -%}{% if pt != '' %}<li>{{ pt }}</li>{% endif %}{%- endfor -%}
      </ul>
      <div class="spdp-gifts" data-js-gifts>
        <div class="spdp-gifts-h">{{ section.settings.gifts_title | default: 'Included with Your First Subscription' }}</div>
        <div class="spdp-gifts-row">
          {% if section.settings.gift1 != blank %}<div class="spdp-gift">{% if section.settings.gift1_img != blank %}<span class="spdp-gift-im">{% if section.settings.gift1_tag != blank %}<i>{{ section.settings.gift1_tag }}</i>{% endif %}<img src="{{ section.settings.gift1_img | image_url: width: 220 }}" loading="lazy" alt="{{ section.settings.gift1 | escape }}"></span>{% endif %}<b>{{ section.settings.gift1 }}</b></div>{% endif %}
          {% if section.settings.gift2 != blank %}<div class="spdp-gift">{% if section.settings.gift2_img != blank %}<span class="spdp-gift-im">{% if section.settings.gift2_tag != blank %}<i>{{ section.settings.gift2_tag }}</i>{% endif %}<img src="{{ section.settings.gift2_img | image_url: width: 220 }}" loading="lazy" alt="{{ section.settings.gift2 | escape }}"></span>{% endif %}<b>{{ section.settings.gift2 }}</b></div>{% endif %}
          {% if section.settings.gift3 != blank %}<div class="spdp-gift">{% if section.settings.gift3_img != blank %}<span class="spdp-gift-im">{% if section.settings.gift3_tag != blank %}<i>{{ section.settings.gift3_tag }}</i>{% endif %}<img src="{{ section.settings.gift3_img | image_url: width: 220 }}" loading="lazy" alt="{{ section.settings.gift3 | escape }}"></span>{% endif %}<b>{{ section.settings.gift3 }}</b></div>{% endif %}
        </div>
        {%- assign fgifts = section.blocks | where: 'type', 'gift' -%}
        {%- if fgifts.size > 0 -%}
        <div class="spdp-fg-h">{{ section.settings.gift_title2 | default: 'Future Subscriber Gifts' }}</div>
        <div class="spdp-fg-row">
          {%- for gb in fgifts limit: 4 -%}
          <div class="spdp-fg" {{ gb.shopify_attributes }}>
            <i data-fg-month>{{ gb.settings.month }}</i>
            {%- if gb.settings.img != blank -%}<span class="spdp-fg-im"><img src="{{ gb.settings.img | image_url: width: 160 }}" loading="lazy" alt="{{ gb.settings.name | escape }}"></span>{%- else -%}<span class="spdp-fg-im spdp-fg-ph">🎁</span>{%- endif -%}
            <b>{{ gb.settings.name }}</b>
            {%- if gb.settings.value != blank -%}<em>{{ gb.settings.value }}</em>{%- endif -%}
          </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>
    </div>
    <button class="spdp-bigcta spdp-cta" 
        data-ph-capture-attribute-product-name="{{product.title}}"
        data-ph-capture-attribute-product-price="{{product.price | divided_by: 100 }}"
      id="{{ fid }}-cta" data-jb-atc><span>{{ section.settings.cta_main | default: 'Try Somna Today' }} →</span><span class="spdp-ctapr"><s data-jb-ctawas></s><b data-jb-ctanow></b></span></button>
    <a href="#" class="spdp-once" data-jb-toggle data-once-label="{{ section.settings.toggle_once | default: 'Try it Once. No Subscription' | escape }}" data-sub-label="{{ section.settings.toggle_sub | default: 'Switch to Subscription — 50% OFF first order' | escape }}">{{ section.settings.toggle_once | default: 'Try it Once. No Subscription' }}</a>
    <div class="spdp-oncemeta">{{ section.settings.once_meta }}</div>
    <div class="spdp-subvalue">{{ section.settings.sub_value | default: 'Subscribers save more, receive exclusive first-order benefits, and can cancel anytime.' }}</div>
    <div class="spdp-shipsby"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{{ section.settings.ships_label | default: 'Ships by:' }} <b data-jb-shipsby></b></span></div>
    </div>

    {%- assign hasfaq = false -%}{%- for b in section.blocks -%}{%- if b.type == 'faq' -%}{%- assign hasfaq = true -%}{%- endif -%}{%- endfor -%}
    {%- if hasfaq -%}<div class="spdp-faq"><div class="cda-acc">{%- for block in section.blocks -%}{%- if block.type == 'faq' -%}<details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}<span class="cda-ic">+</span></summary><div class="cda-ans">{{ block.settings.a }}</div></details>{%- endif -%}{%- endfor -%}</div></div>{%- endif -%}

    {%- if section.settings.g_title != blank or section.settings.g_tile != blank -%}
    <div class="spdp-gcard{% if section.settings.g_tile != blank %} spdp-gcard-tilemode{% endif %}">
      {%- if section.settings.g_tile != blank -%}
      <img class="spdp-gcard-full" src="{{ section.settings.g_tile | image_url: width: 1000 }}" loading="lazy" alt="{{ section.settings.g_title | escape }}">
      {%- unless section.settings.g_hide_overlay -%}
      <div class="spdp-gcard-over">
        <div class="spdp-gcard-t">{{ section.settings.g_title }}</div>
        {%- if section.settings.g_body != blank -%}<div class="spdp-gcard-p">{{ section.settings.g_body }}</div>{%- endif -%}
        <a class="spdp-gcard-cta" href="{{ section.settings.g_link | default: '#cda-buy' }}">{{ section.settings.g_cta | default: 'Try Somna Risk-Free' }}</a>
      </div>
      {%- endunless -%}
      {%- else -%}
      <div class="spdp-gcard-b">
        <div class="spdp-gcard-t">{{ section.settings.g_title }}</div>
        {%- if section.settings.g_body != blank -%}<div class="spdp-gcard-p">{{ section.settings.g_body }}</div>{%- endif -%}
        <a class="spdp-gcard-cta" href="{{ section.settings.g_link | default: '#cda-buy' }}">{{ section.settings.g_cta | default: 'Try Somna Risk-Free' }}</a>
      </div>
      <div class="spdp-gcard-img">{%- if section.settings.g_image != blank -%}<img src="{{ section.settings.g_image | image_url: width: 700 }}" loading="lazy" alt="">{%- else -%}<div class="spdp-gcard-ph">Insert image</div>{%- endif -%}</div>
      {%- endif -%}
    </div>
    {%- endif -%}

    {%- assign hasvid = false -%}{%- for b in section.blocks -%}{%- if b.type == 'vid' -%}{%- assign hasvid = true -%}{%- endif -%}{%- endfor -%}
    {%- if hasvid -%}<div class="spdp-testi"><div class="spdp-testi-h">{{ section.settings.testi_title }}</div><div class="spdp-testi-row">{%- for block in section.blocks -%}{%- if block.type == 'vid' -%}{%- if block.settings.vid != blank -%}<div class="spdp-tcard" {{ block.shopify_attributes }}><video class="spdp-tv" playsinline preload="metadata"{% if block.settings.image != blank %} poster="{{ block.settings.image | image_url: width: 600 }}"{% endif %}>{%- for source in block.settings.vid.sources -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endfor -%}</video><button type="button" class="spdp-tgo" aria-label="Play video"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg></button>{%- assign vcap = block.settings.caption | strip -%}{% if vcap != blank and vcap != 'Insert UGC video' %}<span class="spdp-tcap">{{ vcap }}</span>{% endif %}</div>{%- elsif block.settings.url != blank -%}<a class="spdp-tcard" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="cda-ph"><img src="{{ block.settings.image | image_url: width: 400 }}" alt=""></div>{% else %}<div class="cda-ph" data-label="Video"></div>{% endif %}<span class="spdp-tplay">▶</span></a>{%- else -%}<div class="spdp-tcard" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="cda-ph"><img src="{{ block.settings.image | image_url: width: 400 }}" alt=""></div>{% else %}<div class="cda-ph" data-label="Insert video"></div>{% endif %}</div>{%- endif -%}{%- endif -%}{%- endfor -%}</div></div>{%- endif -%}
  </div>
</div></div>
  <div class="spdp-sticky" data-spsb-sticky>
    <button type="button" class="spdp-sticky-sel" data-spsb-stickysel aria-haspopup="true"><span class="spdp-sticky-txt"><span class="spdp-sticky-name" data-spsb-stickyname></span><span class="spdp-sticky-price" data-spsb-stickyprice></span></span><i class="spdp-sticky-car">▾</i></button>
    <button type="button" class="spdp-sticky-cta" id="{{ fid }}-stickycta">ADD TO CART</button>
    <div class="spdp-sticky-menu" data-spsb-stickymenu></div>
  </div>
</section>
<style>
html{scroll-behavior:smooth}
#cda-buy{scroll-margin-top:14px}
.spdp .cda-wrap{max-width:1150px}
.spdp-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:clamp(28px,4vw,52px);align-items:start;font-family:var(--cda-font)}
.spdp-media{position:sticky;top:80px;min-width:0}
.spdp-buy{min-width:0}
.spdp-main{margin-bottom:10px}
.spdp-thumbs{display:flex;gap:8px}
.spdp-thumbs button{flex:1 1 0;min-width:0;max-width:68px;border:1.5px solid #E5E7EB;border-radius:11px;padding:0;cursor:pointer;background:#fff;overflow:hidden;transition:transform .25s,border-color .2s}
.spdp-thumbs button img{width:100%;height:100%;object-fit:cover;display:block;aspect-ratio:1/1}
.spdp-thumbs button.sel{border:2px solid #111129}
.spdp-thumbs button:hover{transform:translateY(-2px)}
.spdp-thumbs .cda-ph{flex:1 1 0;min-width:0;max-width:68px;aspect-ratio:1/1;border-radius:11px}
.spdp-revcard{display:flex;gap:12px;margin-top:12px;background:#F6F7FB;border:1.5px solid #111129;border-radius:14px;padding:12px;align-items:center}
.spdp-rev-l{flex:0 0 80px;display:flex;flex-direction:column;align-items:center;gap:2px;text-align:center}
.spdp-rev-l img{width:42px;height:42px;border-radius:50%;object-fit:cover;margin-bottom:2px}
.spdp-rev-avph{width:42px;height:42px;border-radius:50%;background:#E7EAF4;display:flex;align-items:center;justify-content:center;font-size:1.05rem;margin-bottom:2px}
.spdp-rev-l b{font-size:.7rem;font-weight:700;color:var(--cda-ink);line-height:1.2}
.spdp-rev-l span{font-size:.5rem;font-weight:700;letter-spacing:.07em;color:var(--cda-muted);text-transform:uppercase}
.spdp-rev-r{flex:1;min-width:0}
.spdp-rev-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.spdp-rev-top .cda-stars{font-size:.72rem;letter-spacing:1px}
.spdp-rev-top b{font-size:.82rem;font-weight:700;color:var(--cda-ink);line-height:1.3}
.spdp-rev-r p{margin:5px 0 0;font-size:.79rem;line-height:1.5;color:#3c3a4a;font-weight:400}
.spdp-h1jp{font-family:'Lora',Georgia,serif;font-size:clamp(1.5rem,2.7vw,2rem);font-weight:600;line-height:1.14;letter-spacing:-.015em;margin:0 0 8px;color:var(--cda-ink);text-transform:none}
.spdp-rate{display:flex;align-items:center;gap:5px;font-size:clamp(.66rem,1.25vw,.78rem);flex-wrap:nowrap;white-space:nowrap;overflow:hidden;margin-bottom:10px}
.spdp-rate .cda-stars{font-size:clamp(.68rem,1.25vw,.8rem);letter-spacing:.5px;flex:none}
.spdp-rate strong{flex:none;font-weight:700}
.spdp-ratemeta{overflow:hidden;text-overflow:ellipsis}
.spdp-sub{color:var(--cda-muted);font-size:.9rem;line-height:1.6;margin-bottom:12px;font-weight:400}
.spdp-jbl{display:flex;flex-direction:column;gap:6px;margin-bottom:16px}
.spdp-jb{position:relative;padding:1px 0 1px 12px;font-size:.83rem;font-weight:500;color:var(--cda-ink);line-height:1.5}
.spdp-jb:before{content:'';position:absolute;left:0;top:4px;bottom:4px;width:2px;border-radius:2px;background:var(--cda-accent)}
.spdp-label{font-size:.77rem;font-weight:700;color:var(--cda-ink);margin:0 0 9px}
.spdp-bwrap{display:grid;gap:9px;margin-bottom:16px}
.spdp-bcard{position:relative;display:flex;align-items:center;gap:12px;border:1.5px solid #E7E9EF;border-radius:14px;padding:11px 14px;cursor:pointer;background:#fff;transition:border-color .18s,box-shadow .18s}
.spdp-bcard.sel{border:1.5px solid var(--cda-accent);box-shadow:0 4px 14px rgba(132,145,197,.18);background:#FBFCFE}
.spdp-pop{position:absolute;top:-8px;right:14px;background:{{ bdg }};color:#fff;font-size:.53rem;font-weight:700;letter-spacing:.08em;padding:3px 8px;border-radius:999px;z-index:2}
.spdp-bimg{flex:0 0 auto;width:66px;height:50px;display:flex;align-items:center;justify-content:center}
.spdp-bimg img{max-width:100%;max-height:100%;object-fit:contain;display:block}
.spdp-bth{display:flex;flex:0 0 auto}
.spdp-bth img{width:44px;height:44px;border-radius:8px;object-fit:cover;border:2px solid #fff;box-shadow:0 2px 6px rgba(17,17,41,.12)}
.spdp-bcopy{flex:1;min-width:0}
.spdp-bt{display:flex;align-items:center;gap:7px;font-weight:700;font-size:.9rem;color:var(--cda-ink);flex-wrap:wrap;letter-spacing:-.005em}
.spdp-bsave{font-style:normal;background:{{ bdg }};color:#fff;font-size:.56rem;font-weight:700;letter-spacing:.05em;padding:3px 8px;border-radius:999px}
.spdp-bsave:empty{display:none}
.spdp-bs{display:block;font-size:.73rem;color:var(--cda-muted);margin-top:1px;font-weight:400}
.spdp-bp{text-align:right;flex:0 0 auto}
.spdp-bp b{display:block;font-size:.92rem;font-weight:700;color:var(--cda-ink)}
.spdp-bp s{display:block;font-size:.7rem;color:var(--cda-muted);font-weight:400}
.spdp-bp s:empty{display:none}
.spdp-sum{border:1.5px solid var(--cda-accent);border-radius:16px;padding:15px;background:#FBFCFE;margin:0 0 14px;box-shadow:0 5px 18px -12px rgba(132,145,197,.35)}
.spdp-sum-top{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.spdp-sum-radio{width:14px;height:14px;border-radius:50%;border:4.5px solid var(--cda-accent);background:#fff;flex:none}
.spdp-sum-supply{font-weight:700;font-size:.88rem;color:var(--cda-ink)}
.spdp-sum-badge{margin-left:auto}
.spdp-sum-price{display:flex;align-items:baseline;gap:9px}
.spdp-sum-price b{font-size:1.5rem;font-weight:700;color:var(--cda-ink);letter-spacing:-.02em}
.spdp-sum-price s{color:var(--cda-muted);font-weight:400;font-size:.85rem}
.spdp-sum-price s:empty{display:none}
.spdp-sum-then{font-size:.76rem;color:var(--cda-muted);margin:1px 0 10px;font-weight:400}
.spdp-sum-perks{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.spdp-sum-perks li{position:relative;padding-left:19px;font-size:.8rem;font-weight:500;color:var(--cda-ink);line-height:1.4}
.spdp-sum-perks li:before{content:'✓';position:absolute;left:0;top:0;color:var(--cda-accent);font-weight:700;font-size:.78rem}
.spdp-gifts{margin-top:12px;border:1px dashed #92A8D8;border-radius:14px;overflow:hidden;background:linear-gradient(180deg,#EDF4FD 0%,#DDE9F8 100%)}
.spdp-gifts-h{background:var(--cda-accent);color:#fff;font-size:.58rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase;text-align:center;padding:8px 10px}
.spdp-gifts-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;padding:12px}
