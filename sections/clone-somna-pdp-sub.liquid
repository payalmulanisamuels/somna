<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');if(!root)return;
  var opts=root.querySelectorAll('[data-bundle]');
  var ctaPrice=root.querySelector('[data-spdp-cta-price]'),btn=document.getElementById('{{ fid }}-cta');
  function money(n){return '$'+(Math.round(n*100)/100).toFixed(2).replace(/\.00$/,'');}
  function curOpt(){return root.querySelector('[data-bundle].sel')||opts[0];}
  function render(){opts.forEach(function(o){var pe=o.querySelector('[data-price]');if(!pe)return;var base=parseFloat(o.getAttribute('data-base'))||0;pe.textContent=money(base);});var o=curOpt(),pr=parseFloat(o.getAttribute('data-base'))||0;var isSub=(o.getAttribute('data-items')||'').indexOf('|')>-1;if(ctaPrice)ctaPrice.textContent=money(pr);if(btn)btn.textContent=(isSub?'Subscribe & Save · ':'Add to cart · ')+money(pr);var sp=root.querySelector('[data-spsb-stickyprice]');if(sp)sp.textContent=money(pr);var sn=root.querySelector('[data-spsb-stickyname]');if(sn)sn.textContent=o.getAttribute('data-name')||'';var scl=document.getElementById('{{ fid }}-stickycta');if(scl)scl.textContent=(isSub?'SUBSCRIBE & SAVE':'ADD TO CART');}
  opts.forEach(function(o){o.addEventListener('click',function(e){e.preventDefault();opts.forEach(function(x){x.classList.remove('sel');});o.classList.add('sel');render();});});
  root.querySelectorAll('[data-spsb-thumb]').forEach(function(t){t.addEventListener('click',function(){var big=document.querySelector('#{{ fid }}-main img');if(big)big.src=t.getAttribute('data-spsb-thumb');});});
  var ssel=root.querySelector('[data-spsb-stickysel]'),smenu=root.querySelector('[data-spsb-stickymenu]');
  if(ssel&&smenu){opts.forEach(function(o,i){if((o.getAttribute('data-items')||'').indexOf('|')===-1){return;}var mi=document.createElement('button');mi.type='button';mi.className='spdp-smenu-i';mi.textContent=(o.getAttribute('data-name')||('Option '+(i+1)));mi.addEventListener('click',function(e){e.preventDefault();opts.forEach(function(x){x.classList.remove('sel');});o.classList.add('sel');render();smenu.classList.remove('open');});smenu.appendChild(mi);});ssel.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();smenu.classList.toggle('open');});document.addEventListener('click',function(e){if(ssel.contains(e.target)||smenu.contains(e.target))return;smenu.classList.remove('open');});}
  render();
})();
</script>
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');if(!root)return;
  var box=document.getElementById('{{ fid }}-main');var main=box?box.querySelector('img'):null;
  var th=[].slice.call(root.querySelectorAll('[data-spsb-thumb],[data-spdp-thumb]'));
  var navs=root.querySelectorAll('.spdp-gnav');
  if(!main||th.length<2){for(var k=0;k<navs.length;k++)navs[k].style.display='none';return;}
  var urls=th.map(function(t){return t.getAttribute('data-spsb-thumb')||t.getAttribute('data-spdp-thumb');});
  var idx=0;
  function setA(){th.forEach(function(t,j){t.classList.toggle('sel',j===idx);});}
  function show(i){idx=(i+urls.length)%urls.length;main.src=urls[idx];setA();}
  th.forEach(function(t,i){t.addEventListener('click',function(){idx=i;setA();});});
  var pa=root.querySelector('[data-gprev]'),na=root.querySelector('[data-gnext]');
  if(pa)pa.addEventListener('click',function(e){e.preventDefault();show(idx-1);});
  if(na)na.addEventListener('click',function(e){e.preventDefault();show(idx+1);});
  var sx=null;
  box.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
  box.addEventListener('touchend',function(e){if(sx==null)return;var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40)show(dx<0?idx+1:idx-1);sx=null;},{passive:true});
  setA();
})();
</script>
<script>
(function(){
  var r=document.getElementById('shopify-section-{{ section.id }}');if(!r)return;
  var fill=r.querySelector('[data-spdp-fsfill]'),txt=r.querySelector('[data-spdp-fstxt]');if(!fill)return;var TH=5000;
  fetch('/cart.js').then(function(x){return x.json();}).then(function(c){var t=c.total_price||0;var bdg=r.querySelector('[data-spsb-cartcount]');if(bdg)bdg.textContent=c.item_count||0;var pct=Math.min(100,Math.round(t/TH*100));if(t<TH){pct=Math.max(6,pct);}fill.style.width=pct+'%';if(t>=TH){txt.textContent='You have unlocked free shipping';}else{txt.textContent='You are $'+((TH-t)/100).toFixed(2)+' away from free shipping';}}).catch(function(){fill.style.width='0%';});
})();
</script>
