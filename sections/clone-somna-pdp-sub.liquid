.spdp-sticky-cta{flex:0 0 auto;min-height:52px;background:#98A3DE;color:#fff;border:none;border-radius:14px;padding:0 22px;font-size:1rem;font-weight:800;cursor:pointer;white-space:nowrap}
.spdp-sticky-menu{display:none;position:absolute;left:13px;right:13px;bottom:calc(100% + 8px);background:#fff;border-radius:14px;box-shadow:0 -8px 30px rgba(0,0,0,.28);overflow:hidden;border:1px solid rgba(17,17,41,.1)}
