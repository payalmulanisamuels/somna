{{ 'clone-dreamx-alarm-styles.css' | asset_url | stylesheet_tag }}
{%- assign cur = product.selected_or_first_available_variant -%}
{%- assign fid = 'spsb-' | append: section.id -%}
<section class="cda-section spdp" id="cda-buy"><div class="cda-wrap"><div class="spdp-grid">
  <div class="spdp-media">
    {%- if product.media.size > 0 -%}
      <div class="spdp-main cda-ph" id="{{ fid }}-main"><img src="{{ product.featured_media | image_url: width: 1100 }}" alt="{{ product.title | escape }}" width="1100" height="1100" loading="eager"><button type="button" class="spdp-gnav spdp-gnav-l" data-gprev aria-label="Previous image">‹</button><button type="button" class="spdp-gnav spdp-gnav-r" data-gnext aria-label="Next image">›</button>{% if section.settings.hero_badge != blank %}<span class="spdp-hbadge">{{ section.settings.hero_badge }}</span>{% endif %}</div>
      <div class="spdp-thumbs">{%- for m in product.media limit: 6 -%}<button class="cda-ph" data-spsb-thumb="{{ m | image_url: width: 1100 }}"><img src="{{ m | image_url: width: 240 }}" alt="" width="240" height="240" loading="lazy"></button>{%- endfor -%}</div>
    {%- else -%}
      <div class="spdp-main cda-ph" id="{{ fid }}-main" data-label="Main image"></div>
      <div class="spdp-thumbs"><div class="cda-ph" data-label="1:1"></div><div class="cda-ph" data-label="1:1"></div><div class="cda-ph" data-label="1:1"></div><div class="cda-ph" data-label="1:1"></div></div>
    {%- endif -%}
  </div>
  <div class="spdp-buy">
    <div class="spdp-herocard">
    <div class="spdp-kick">{{ section.settings.kicker }}</div>
    <h1 class="spdp-h1">{{ section.settings.head_a }} <span class="spdp-accent">{{ section.settings.head_b }}</span></h1>
    <div class="spdp-sub">{{ section.settings.subhead }}</div>
    {%- assign pills = section.settings.pills | split: ',' -%}
    <div class="spdp-pills">{%- for p in pills -%}<span>✓ {{ p | strip }}</span>{%- endfor -%}</div>
    <div class="spdp-card"><div class="spdp-card-h">{{ section.settings.why_title }}</div><p class="cda-muted" style="margin:0 0 14px">{{ section.settings.why_body }}</p>{%- assign checks = section.settings.checks | newline_to_br | split: '<br />' -%}<ul class="spdp-checks">{%- for c in checks -%}{%- assign ct = c | strip -%}{% if ct != '' %}<li>{{ ct }}</li>{% endif %}{%- endfor -%}</ul></div>
    {%- assign vm = product.variants[0] -%}{%- assign vq = product.variants[1] -%}
    {%- assign moBilledC = vm.price | times: 0.8 -%}{%- assign qBilledC = vq.price | times: 0.65 -%}
    {%- assign moBase = moBilledC | divided_by: 100.0 -%}{%- assign qBase = qBilledC | divided_by: 100.0 -%}{%- assign oneBase = vm.price | divided_by: 100.0 -%}
    {%- assign moDayC = moBilledC | divided_by: 30 -%}{%- assign qDayC = qBilledC | divided_by: 90 -%}
    {%- assign kitblocks = section.blocks | where: 'type', 'kit' -%}{%- assign giftblocks = section.blocks | where: 'type', 'gift' -%}
    <div class="spdp-label">{{ section.settings.plan_label | default: 'Choose your plan' }}</div>
    <div class="spdp-opts spsb" id="{{ fid }}-opts">
      <label class="spsb-card sel" data-bundle data-items="{{ vq.id }}|5928714471" data-base="{{ qBase }}" data-name="Quarterly (90-Day)">
        <div class="spsb-ban">★ MOST POPULAR · BEST VALUE · SAVE 35%</div>
        <div class="spsb-pad">
          <div class="spsb-top"><strong>90-Day Subscription</strong><span class="spsb-savebadge">SAVE 35%</span></div>
          <div class="spsb-price"><span class="spsb-day">{{ qDayC | money }}</span><span class="spsb-dayl">/day</span><s class="spsb-was">{{ vq.price | money }}</s></div>
          <div class="spsb-line">Billed {{ qBilledC | money }} today · ships every 90 days · cancel anytime</div>
          <div class="spsb-body">
            <div class="spsb-kit-h"><span>{{ section.settings.kit_title }}</span><span class="spsb-val">{{ section.settings.kit_value }} value FREE</span></div>
            <div class="spsb-kit-row">{% if kitblocks.size > 0 %}{% for kb in kitblocks %}<div class="spsb-item">{% if kb.settings.img %}<div class="cda-ph"><img src="{{ kb.settings.img | image_url: width: 160 }}" alt=""></div>{% else %}<div class="cda-ph"></div>{% endif %}<div class="spsb-it-n">{{ kb.settings.name }}</div><div class="spsb-it-p">{{ kb.settings.value }}</div></div>{% endfor %}{% else %}{%- assign kitlines = section.settings.kit_items | newline_to_br | split: '<br />' -%}{% for kl in kitlines %}{%- assign kp = kl | strip | split: '|' -%}{% if kp[0] != blank %}<div class="spsb-item"><div class="cda-ph"></div><div class="spsb-it-n">{{ kp[0] | strip }}</div><div class="spsb-it-p">{{ kp[1] | strip }}</div></div>{% endif %}{% endfor %}{% endif %}</div>
            <div class="spsb-kit-h" style="margin-top:12px"><span>{{ section.settings.gift_title }}</span></div>
            <div class="spsb-kit-row">{% if giftblocks.size > 0 %}{% for gb in giftblocks %}{% unless gb.settings.plan == 'm' %}<div class="spsb-item"><div class="spsb-month">{{ gb.settings.month }}</div>{% if gb.settings.img %}<div class="cda-ph"><img src="{{ gb.settings.img | image_url: width: 160 }}" alt=""></div>{% else %}<div class="cda-ph"></div>{% endif %}<div class="spsb-it-n">{{ gb.settings.name }}</div><div class="spsb-it-p">{{ gb.settings.value }}</div></div>{% endunless %}{% endfor %}{% else %}{%- assign giftlines = section.settings.gifts_90 | newline_to_br | split: '<br />' -%}{% for gl in giftlines %}{%- assign gp = gl | strip | split: '|' -%}{% if gp[0] != blank %}<div class="spsb-item"><div class="spsb-month">{{ gp[0] | strip }}</div><div class="cda-ph"></div><div class="spsb-it-n">{{ gp[1] | strip }}</div><div class="spsb-it-p">{{ gp[2] | strip }}</div></div>{% endif %}{% endfor %}{% endif %}</div>
          </div>
        </div>
      </label>
      <label class="spsb-card" data-bundle data-items="{{ vm.id }}|5928681703" data-base="{{ moBase }}" data-name="Monthly (30-Day)">
        <div class="spsb-pad">
          <div class="spsb-top"><strong>Monthly Subscription</strong><span class="spsb-savebadge">SAVE 20%</span></div>
          <div class="spsb-price"><span class="spsb-day">{{ moDayC | money }}</span><span class="spsb-dayl">/day</span><s class="spsb-was">{{ vm.price | money }}</s></div>
          <div class="spsb-line">Billed {{ moBilledC | money }} today · ships every 30 days · cancel anytime</div>
          <div class="spsb-body">
            <div class="spsb-kit-h"><span>{{ section.settings.kit_title }}</span><span class="spsb-val">{{ section.settings.kit_value }} value FREE</span></div>
            <div class="spsb-kit-row">{% if kitblocks.size > 0 %}{% for kb in kitblocks %}<div class="spsb-item">{% if kb.settings.img %}<div class="cda-ph"><img src="{{ kb.settings.img | image_url: width: 160 }}" alt=""></div>{% else %}<div class="cda-ph"></div>{% endif %}<div class="spsb-it-n">{{ kb.settings.name }}</div><div class="spsb-it-p">{{ kb.settings.value }}</div></div>{% endfor %}{% else %}{%- assign kitlines = section.settings.kit_items | newline_to_br | split: '<br />' -%}{% for kl in kitlines %}{%- assign kp = kl | strip | split: '|' -%}{% if kp[0] != blank %}<div class="spsb-item"><div class="cda-ph"></div><div class="spsb-it-n">{{ kp[0] | strip }}</div><div class="spsb-it-p">{{ kp[1] | strip }}</div></div>{% endif %}{% endfor %}{% endif %}</div>
            <div class="spsb-kit-h" style="margin-top:12px"><span>{{ section.settings.gift_title }}</span></div>
            <div class="spsb-kit-row">{% if giftblocks.size > 0 %}{% for gb in giftblocks %}{% unless gb.settings.plan == 'q' %}<div class="spsb-item"><div class="spsb-month">{{ gb.settings.month }}</div>{% if gb.settings.img %}<div class="cda-ph"><img src="{{ gb.settings.img | image_url: width: 160 }}" alt=""></div>{% else %}<div class="cda-ph"></div>{% endif %}<div class="spsb-it-n">{{ gb.settings.name }}</div><div class="spsb-it-p">{{ gb.settings.value }}</div></div>{% endunless %}{% endfor %}{% else %}{%- assign giftlines = section.settings.gifts_30 | newline_to_br | split: '<br />' -%}{% for gl in giftlines %}{%- assign gp = gl | strip | split: '|' -%}{% if gp[0] != blank %}<div class="spsb-item"><div class="spsb-month">{{ gp[0] | strip }}</div><div class="cda-ph"></div><div class="spsb-it-n">{{ gp[1] | strip }}</div><div class="spsb-it-p">{{ gp[2] | strip }}</div></div>{% endif %}{% endfor %}{% endif %}</div>
          </div>
        </div>
      </label>
      <label class="spsb-once" data-bundle data-items="{{ vm.id }}" data-base="{{ vm.price | divided_by: 100.0 }}" data-name="One-time"><span class="spsb-once-inner"><span class="spdp-radio"></span><span class="spsb-once-copy"><span class="spsb-once-t">One-time purchase</span><span class="spsb-once-meta">{{ vm.price | money }} · + $5.95 shipping</span></span><span class="spsb-once-badge">No subscription</span></span></label>
    </div>
    <button class="cda-btn spsb-cta"
        data-ph-capture-attribute-product-name="{{product.title}}"
  data-ph-capture-attribute-product-price="{{product.price | divided_by: 100 }}"

      id="{{ fid }}-cta">Add to cart — <span data-spdp-cta-price></span></button>
    <div class="cda-trust" style="text-align:center">🔒 Secure checkout · {{ section.settings.guarantee }}</div>
    <div class="spdp-pays"><span>VISA</span><span>MC</span><span>AMEX</span><span>PayPal</span><span>G Pay</span></div>

    {%- assign tlist = section.settings.trust_items | newline_to_br | split: '<br />' -%}
    {% if section.settings.trust_items != blank %}<ul class="spdp-trust">{%- for t in tlist -%}{%- assign tt = t | strip -%}{% if tt != '' %}<li>{{ tt }}</li>{% endif %}{%- endfor -%}</ul>{% endif %}
    

    </div>

    {%- assign hasfaq = false -%}{%- for b in section.blocks -%}{%- if b.type == 'faq' -%}{%- assign hasfaq = true -%}{%- endif -%}{%- endfor -%}
    {%- if hasfaq -%}<div class="spdp-faq"><div class="spdp-faq-h">{{ section.settings.faq_title }}</div><div class="cda-acc">{%- for block in section.blocks -%}{%- if block.type == 'faq' -%}<details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}<span class="cda-ic">+</span></summary><div class="cda-ans">{{ block.settings.a }}</div></details>{%- endif -%}{%- endfor -%}</div></div>{%- endif -%}

    {%- assign hasaddon = false -%}{%- for b in section.blocks -%}{%- if b.type == 'addon' -%}{%- assign hasaddon = true -%}{%- endif -%}{%- endfor -%}
    {%- if hasaddon -%}<div class="spdp-sys"><h3>{{ section.settings.sys_title }}</h3><p class="cda-muted" style="margin:2px 0 0">{{ section.settings.sys_sub }}</p>{%- for block in section.blocks -%}{%- if block.type == 'addon' -%}{%- assign ap = block.settings.prod -%}<div class="spdp-addon" {{ block.shopify_attributes }}>{% if ap != blank and ap.featured_image %}<div class="cda-ph"><img src="{{ ap.featured_image | image_url: width: 160 }}" alt=""></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %}<div><div class="spdp-an">{{ ap.title | default: block.settings.name }}</div><div class="cda-muted" style="font-size:.84rem">{{ block.settings.desc }}</div><div class="spdp-ap">{% if ap != blank %}{{ ap.price | money }}{% endif %}</div>{% if ap != blank %}{% render 'somna-plan-select', variant: ap.selected_or_first_available_variant, id_prefix: block.id %}{% endif %}</div>{% if ap != blank %}<button class="spdp-add" data-spsb-add="{{ ap.selected_or_first_available_variant.id }}">Add +</button>{% endif %}</div>{%- endif -%}{%- endfor -%}</div>{%- endif -%}

    {%- assign hasvid = false -%}{%- for b in section.blocks -%}{%- if b.type == 'vid' -%}{%- assign hasvid = true -%}{%- endif -%}{%- endfor -%}
    {%- if hasvid -%}<div class="spdp-testi"><div class="spdp-testi-h">{{ section.settings.testi_title }} <span class="cda-muted" style="font-weight:500">· tap to play</span></div><div class="spdp-testi-row">{%- for block in section.blocks -%}{%- if block.type == 'vid' -%}{%- if block.settings.vid != blank -%}<div class="spdp-tcard" {{ block.shopify_attributes }}><video class="spdp-tv" playsinline controls preload="none"{% if block.settings.image != blank %} poster="{{ block.settings.image | image_url: width: 600 }}"{% endif %}>{%- for source in block.settings.vid.sources -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endfor -%}</video><span class="spdp-tcap">{{ block.settings.caption }}</span></div>{%- elsif block.settings.url != blank -%}<a class="spdp-tcard" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="cda-ph"><img src="{{ block.settings.image | image_url: width: 400 }}" alt=""></div>{% else %}<div class="cda-ph" data-label="Video"></div>{% endif %}<span class="spdp-tplay">▶</span><span class="spdp-tcap">{{ block.settings.caption }}</span></a>{%- else -%}<div class="spdp-tcard" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="cda-ph"><img src="{{ block.settings.image | image_url: width: 400 }}" alt=""></div>{% else %}<div class="cda-ph" data-label="Video"></div>{% endif %}<span class="spdp-tcap">{{ block.settings.caption }}</span></div>{%- endif -%}{%- endif -%}{%- endfor -%}</div></div>{%- endif -%}
  </div>
</div></div>
  <div class="spdp-sticky" data-spsb-sticky>
    <button type="button" class="spdp-sticky-sel" data-spsb-stickysel aria-haspopup="true"><span class="spdp-sticky-txt"><span class="spdp-sticky-name" data-spsb-stickyname></span><span class="spdp-sticky-price" data-spsb-stickyprice></span></span><i class="spdp-sticky-car">▾</i></button>
    <button type="button" class="spdp-sticky-cta" id="{{ fid }}-stickycta">ADD TO CART</button>
    <div class="spdp-sticky-menu" data-spsb-stickymenu></div>
  </div>
</section>
<style>
.spdp .cda-wrap{max-width:1120px}
.spdp-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;font-family:var(--cda-font)}
.spdp-media{position:sticky;top:80px}
.spdp-main{margin-bottom:10px}.spdp-thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.spdp-thumbs button{border:2px solid #111129;border-radius:9px;padding:0;cursor:pointer;background:none;overflow:hidden}.spdp-thumbs button.sel{box-shadow:0 0 0 2px #111129}.spdp-thumbs button:hover{box-shadow:0 0 0 2px rgba(17,17,41,.2)}
.spdp-rate{display:flex;align-items:center;gap:8px;font-size:.92rem}
.spdp-kick{text-transform:uppercase;letter-spacing:.1em;font-size:.72rem;font-weight:800;color:var(--cda-accent);margin:14px 0 6px}
.spdp-h1{font-size:clamp(2rem,4.4vw,3rem);font-weight:800;line-height:1.02;letter-spacing:-.02em;margin:0 0 12px;text-transform:uppercase;color:var(--cda-ink)}
.spdp-accent{color:var(--cda-accent)}
.spdp-sub{color:var(--cda-muted);font-size:1.02rem;margin-bottom:16px}
.spdp-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.spdp-pills span{background:var(--cda-soft);color:var(--cda-accent-d);font-weight:700;font-size:.76rem;padding:5px 11px;border-radius:999px}
.spdp-card{border:1px solid var(--cda-line);border-radius:16px;padding:20px;margin-bottom:22px}
.spdp-card-h{font-weight:800;text-transform:uppercase;letter-spacing:.04em;font-size:.8rem;color:var(--cda-accent);margin-bottom:10px}
.spdp-checks{list-style:none;margin:0;padding:0;display:grid;gap:9px}
.spdp-checks li{padding-left:26px;position:relative;font-weight:500;font-size:.95rem}
.spdp-checks li:before{content:'✓';position:absolute;left:0;color:#fff;background:var(--cda-accent);width:18px;height:18px;border-radius:50%;font-size:.7rem;display:flex;align-items:center;justify-content:center;top:2px}
.spdp-label{font-size:.74rem;text-transform:uppercase;letter-spacing:.1em;font-weight:800;color:var(--cda-muted);margin:0 0 10px}
.spsb-swrow{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.spdp-sets{display:grid;grid-template-columns:repeat(3,1fr);border:1.5px solid var(--cda-line);border-radius:12px;overflow:hidden;margin-bottom:14px}
.spdp-set{border:none;border-right:1px solid var(--cda-line);background:#fff;padding:18px 8px;cursor:pointer;text-align:center;font:inherit;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}
.spdp-set:last-child{border-right:none}
.spdp-set.sel{background:var(--cda-soft)}
.spdp-set-n{font-weight:800;font-size:1.35rem;color:var(--cda-ink)}.spdp-set-s{font-size:.72rem;color:var(--cda-muted)}
.spdp-set-p{font-size:.84rem;font-weight:800;color:var(--cda-accent-d);margin-top:3px}.spdp-set-p s{color:var(--cda-muted);font-weight:500;margin-left:3px}
.spsb-stock{font-size:.85rem;color:var(--cda-ink);margin-bottom:22px}
.spsb-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#e0533a;margin-right:4px}
.spsb{display:grid;gap:12px}
.spsb-card{border:1.5px solid var(--cda-line);border-radius:16px;overflow:hidden;cursor:pointer;background:#fff}
.spsb-card.sel{border-color:var(--cda-accent);box-shadow:0 0 0 3px var(--cda-soft),0 6px 20px rgba(109,73,224,.12)}
.spsb-ban{background:var(--cda-accent);color:#fff;text-align:center;font-size:.7rem;font-weight:800;letter-spacing:.05em;padding:7px}
.spsb-pad{padding:14px 16px 16px}
.spsb-top{display:flex;align-items:center;gap:10px;font-size:1.05rem}
.spsb-savebadge{margin-left:auto;background:#d8f3e3;color:#1b8a5a;font-size:.66rem;font-weight:800;padding:3px 9px;border-radius:999px}
.spsb-price{display:flex;align-items:baseline;gap:6px;margin-top:6px}
.spsb-day{font-size:2.2rem;font-weight:800;color:var(--cda-accent)}
.spsb-dayl{color:var(--cda-muted);font-weight:600}
.spsb-was{margin-left:auto;color:var(--cda-muted);text-decoration:line-through}
.spsb-line{font-size:.86rem;color:var(--cda-muted);display:flex;flex-wrap:wrap;gap:4px;margin-top:2px}
.spsb-save{margin-left:auto;color:#1b8a5a;font-weight:700}
.spsb-body{display:none;margin-top:14px;border-top:1px solid var(--cda-line);padding-top:14px}
.spsb-card.sel .spsb-body{display:block}
.spsb-kit-h{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--cda-muted);margin-bottom:10px;display:flex;justify-content:space-between}
.spsb-val{color:var(--cda-accent-d)}
.spsb-kit-row{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px}
.spsb-item{flex:0 0 80px;text-align:center}
.spsb-item .cda-ph{aspect-ratio:1/1;border-radius:10px;overflow:hidden}
.spsb-item .cda-ph img{width:100%;height:100%;object-fit:cover}
.spsb-it-p{font-size:.7rem;color:var(--cda-muted);margin-top:4px}
.spsb-it-n{font-size:.72rem;font-weight:600;line-height:1.2}
.spsb-month{font-size:.62rem;font-weight:800;color:var(--cda-accent);text-transform:uppercase;margin-bottom:4px}
.spsb-cta{margin-top:4px;font-size:1.05rem}
.spdp-pays{display:flex;gap:6px;justify-content:center;margin-top:14px}
.spdp-pays span{border:1px solid var(--cda-line);border-radius:6px;padding:3px 8px;font-size:.66rem;font-weight:700;color:var(--cda-muted)}
.spdp-trust{list-style:none;margin:18px 0 0;padding:16px 18px;background:var(--cda-soft);border-radius:14px;display:grid;grid-template-columns:1fr 1fr;gap:9px 16px}
.spdp-trust li{position:relative;padding-left:24px;font-size:.84rem;font-weight:600;color:var(--cda-ink);line-height:1.3}
.spdp-trust li:before{content:'✓';position:absolute;left:0;top:1px;color:#fff;background:var(--cda-accent);width:17px;height:17px;border-radius:50%;font-size:.64rem;display:flex;align-items:center;justify-content:center}
.spdp-proof{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-top:14px;justify-content:center;font-size:.9rem}
.spdp-proof .cda-stars{font-size:.95rem}
.spdp-proof-line{width:100%;text-align:center;color:var(--cda-muted);font-weight:600;font-size:.84rem;margin-top:2px}
.spdp-faq{margin-top:28px}.spdp-faq-h{font-weight:800;font-size:1.1rem;margin-bottom:6px}
.spdp-sys{margin-top:28px}.spdp-sys h3{font-size:1.15rem;font-weight:800;margin:0}
.spdp-addon{display:flex;align-items:center;gap:12px;border:1px solid var(--cda-line);border-radius:14px;padding:12px;margin-top:12px;flex-wrap:wrap}
.spdp-addon>div:nth-child(2){flex:1;min-width:140px}
.spdp-addon .cda-ph{width:60px;height:60px;flex:0 0 auto;border-radius:10px}
.spdp-an{font-weight:700;font-size:.95rem}.spdp-ap{font-weight:700;color:var(--cda-accent-d);margin-top:2px}
.spdp-add{margin-left:auto;background:#1b8a5a;color:#fff;border:none;border-radius:999px;padding:9px 16px;font-weight:700;cursor:pointer;flex:0 0 auto;font-size:.85rem}
.spdp-testi{margin-top:28px}.spdp-testi-h{font-weight:800;margin-bottom:12px}
.spdp-testi-row{display:flex;gap:12px;overflow-x:auto;padding-bottom:6px}
.spdp-tcard{position:relative;flex:0 0 130px;border-radius:14px;overflow:hidden;text-decoration:none;color:#fff}
.spdp-tcard .cda-ph{aspect-ratio:9/16;border-radius:14px;background:var(--cda-ink)}
.spdp-tcard .cda-ph img{width:100%;height:100%;object-fit:cover}
