    { "type": "text", "id": "summary_count", "label": "Summary review count", "default": "3,910" },
    { "type": "paragraph", "content": "One review per line: Name | Rating(1-5) | Title | Review text | Date" },
    { "type": "textarea", "id": "reviews_list", "label": "Reviews", "default": "Sarah M.|5|Finally sleeping through the night|I was skeptical but within a week my sleep completely changed. Wouldn't go a night without it now.|2 weeks ago\nJames T.|5|Wish I found this sooner|Genuinely the best sleep purchase I've made. Simple, comfortable, and it just works.|3 weeks ago\nPriya K.|4|Great, takes a couple nights|Took me two or three nights to get used to it, but now it's part of my routine. Noticeably better mornings.|1 month ago\nMarcus D.|5|My partner is thrilled|We both sleep so much better now. No more disturbing each other through the night.|1 month ago\nEmily R.|5|Worth every penny|Premium quality and it actually delivers. I've already recommended it to three friends.|1 month ago\nDavid L.|5|Travel essential now|Goes everywhere with me. Hotels, flights, you name it — my sleep stays consistent.|2 months ago\nAisha N.|4|Really solid|Does exactly what it promises. Knocked off a star only because shipping took a few days.|2 months ago\nTom B.|5|Life changer for a light sleeper|I wake up at the slightest thing normally. This has been the first thing to actually help.|2 months ago\nHannah L.|5|So comfortable|Forgot I was even wearing/using it after the first night. Brilliant.|2 months ago\nCarlos E.|5|Recovery game changer|As someone who trains hard, better sleep has made a real difference to how I feel.|3 months ago\nMegan W.|4|Good value|Happy with it overall. Would love a few more options but it does the job well.|3 months ago\nRyan P.|5|Quietest nights in years|My household finally sleeps in peace. Cannot recommend enough.|3 months ago\nNina S.|5|Exactly as described|No gimmicks, just works. Fast shipping and lovely packaging too.|4 months ago\nOliver H.|5|Bought a second one|Liked the first so much I got one for my partner. We're both converts.|4 months ago\nGrace F.|4|Comfortable and effective|Settled into my routine quickly. Small learning curve but worth it.|5 months ago\nDaniel K.|5|Best sleep upgrade|Tried a lot of things over the years. This is the one that stuck.|6 months ago" }
  ],
  "blocks": [
    { "type": "feat", "name": "Featured review (legacy)", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "role", "label": "Role" },
      { "type": "image_picker", "id": "image", "label": "Avatar (1:1)" }
    ] },
    { "type": "wall", "name": "Wall review (legacy)", "settings": [
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "image_picker", "id": "image", "label": "Avatar (1:1)" }
    ] }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Clone — Reviews" }]
}
{% endschema %}
