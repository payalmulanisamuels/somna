{{ 'clone-dreamx-alarm-styles.css' | asset_url | stylesheet_tag }}
<section class="cda-section cda-cta-sec">
  <div class="cda-wrap">
    <div class="cda-final">
      <h2 class="cda-h2">{{ section.settings.title }}</h2>
      <p>{{ section.settings.body }}</p>
      <a class="cda-btn" href="{{ section.settings.cta_link | default: '#cda-buy' }}">{{ section.settings.cta_label }}</a>
      <div class="cda-badges">
        <div><div class="cda-bi">🔒</div><div class="cda-bt" style="color:#fff">Secure checkout</div><div class="cda-bs">256-bit encrypted</div></div>
        <div><div class="cda-bi">↩️</div><div class="cda-bt" style="color:#fff">100-night guarantee</div><div class="cda-bs">Love it or full refund</div></div>
        <div><div class="cda-bi">🚚</div><div class="cda-bt" style="color:#fff">Fast free shipping</div><div class="cda-bs">Ships within 24 hours</div></div>
        <div><div class="cda-bi">💬</div><div class="cda-bt" style="color:#fff">Real human support</div><div class="cda-bs">7 days a week</div></div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Clone — Final CTA",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Never sleep through an alarm again." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Wake up on time, quietly, and on your own terms — backed by a 100-night money-back guarantee.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Order Yours Today" },
    { "type": "url", "id": "cta_link", "label": "Button link (blank = scroll to buy box)" }
  ],
  "presets": [{ "name": "Clone — Final CTA" }]
}
{% endschema %}
