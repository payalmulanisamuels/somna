{{ 'somna-jp-styles.css' | asset_url | stylesheet_tag }}
<section class="sjp sjp-sec sjp-sp2" style="background:{{ section.settings.bg | default: '#FAF7F2' }}">
  <div class="sjp-wrap">
    <div class="sjp-sp2-head">
      {%- if section.settings.stars_line != blank -%}<div class="sjp-sp2-stars"><span class="sjp-sp2-star">★★★★★</span> {% assign _sl = section.settings.stars_line | split: '(' %}{{ _sl[0] }}{% if _sl.size > 1 %}<span class="sjp-sp2-rev">({{ _sl[1] }}</span>{% endif %}</div>{%- endif -%}
      <h2 class="sjp-sp2-t">{{ section.settings.title_a | default: 'Join' }} <em>{{ section.settings.title_em | default: 'thousands of sleepers' }}</em> {{ section.settings.title_b | default: 'who stopped fighting their nights' }}</h2>
      {%- if section.settings.meta != blank -%}<div class="sjp-sp2-meta">{{ section.settings.meta }}</div>{%- endif -%}
    </div>
    <div class="sjp-sp2-track">
      {%- for block in section.blocks -%}
      <div class="sjp-sp2-card" {{ block.shopify_attributes }}>
        <div class="sjp-sp2-img">{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 1000 }}" loading="lazy" alt="Customer result">{%- else -%}<div class="sjp-sp2-ph">Upload before / after image</div>{%- endif -%}</div>
        <div class="sjp-sp2-bubble">
          <div class="sjp-sp2-bstars">★★★★★</div>
          <p>“{{ block.settings.quote }}”</p>
          <div class="sjp-sp2-name">{{ block.settings.name }}</div>
          <div class="sjp-sp2-vb"><span class="sjp-sp2-ck">✓</span>Verified Buyer</div>
        </div>
      </div>
      {%- endfor -%}
    </div>
    <div class="sjp-ctawrap sjp-sp2-ctawrap">
      <a class="sjp-cta" href="{{ section.settings.cta_url | default: '#cda-buy' }}">{{ section.settings.cta | default: 'Try Somna Tonight' }}</a>
      {%- if section.settings.gline != blank -%}<div class="sjp-gline"><span class="sjp-gdot">✓</span>{{ section.settings.gline }}</div>{%- endif -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="sjp-note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
<style>
.sjp-sp2-head{text-align:center}
.sjp-sp2-stars{font-size:.85rem;font-weight:700;color:var(--ink);margin-bottom:10px;white-space:nowrap}
.sjp-sp2-star{color:#ffb400;letter-spacing:2px;margin-right:6px}
.sjp-sp2-rev{color:var(--ink)}
.sjp-sp2-t{font-family:'Lora',Georgia,serif;font-weight:600;font-size:clamp(1.7rem,4.4vw,2.5rem);line-height:1.1;margin:0;color:var(--ink)}
.sjp-sp2-t em{font-style:italic;color:#5B79F3}
.sjp-sp2-meta{font-size:.78rem;font-weight:700;color:var(--mut);margin-top:10px}
.sjp-sp2-track{display:flex;gap:16px;margin-top:32px;align-items:stretch}
.sjp-sp2-card{flex:1;min-width:0;display:flex;flex-direction:column;gap:14px}
.sjp-sp2-img{aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:#E7E2D8;flex:none}
.sjp-sp2-img img{width:100%;height:100%;object-fit:cover;display:block}
.sjp-sp2-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#E7E2D8;color:#a49f93;font-size:.85rem;font-weight:700;text-align:center;padding:12px}
.sjp-sp2-bubble{background:linear-gradient(135deg,var(--band),var(--band2));color:#fff;border-radius:18px;padding:22px 24px;flex:1;display:flex;flex-direction:column;box-shadow:0 18px 38px -22px rgba(109,73,224,.55)}
.sjp-sp2-bstars{color:#fff;letter-spacing:3px;font-size:.82rem;margin-bottom:14px}
.sjp-sp2-bubble p{margin:0 0 auto;padding-bottom:22px;font-size:.94rem;line-height:1.55;color:#fff}
.sjp-sp2-name{font-size:.9rem;font-weight:600;margin-bottom:10px}
.sjp-sp2-vb{display:flex;align-items:center;gap:8px;font-size:.85rem}
.sjp-sp2-ck{width:18px;height:18px;border-radius:50%;background:#fff;color:var(--band);display:inline-flex;align-items:center;justify-content:center;font-size:.58rem;font-weight:800;flex:none}
.sjp-sp2-ctawrap{text-align:center;margin-top:32px}
@media(max-width:768px){
.sjp-sp2-head{text-align:left}
.sjp-sp2-rev{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1.5px}
.sjp-sp2-track{overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-left:20px;scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;margin:26px -20px 0;padding:0 20px 4px}
.sjp-sp2-track::-webkit-scrollbar{display:none}
.sjp-sp2-card{flex:0 0 86%;scroll-snap-align:start}
.sjp-sp2-ctawrap .sjp-cta{width:100%;justify-content:center;padding:17px 20px}
.sjp-sp2-ctawrap{margin-top:24px}
.sjp-sp2-ctawrap .sjp-gline{justify-content:center;margin-top:13px}
.sjp-sp2-ctawrap .sjp-gdot{background:#5B79F3}
}
</style>
{% schema %}
{
  "name": "JP — Social proof split",
  "settings": [
    { "type": "text", "id": "stars_line", "label": "Stars line", "default": "4.7 (3,910 reviews)" },
    { "type": "text", "id": "title_a", "label": "Title part 1", "default": "Join" },
    { "type": "text", "id": "title_em", "label": "Italic accent", "default": "100,000+ sleepers" },
    { "type": "text", "id": "title_b", "label": "Title part 2", "default": "who stopped fighting their nights" },
    { "type": "text", "id": "meta", "label": "Meta line", "default": "As seen on TikTok" },
    { "type": "text", "id": "cta", "label": "CTA label", "default": "Try Somna Tonight" },
    { "type": "url", "id": "cta_url", "label": "CTA link (default: buy box)" },
    { "type": "text", "id": "gline", "label": "Guarantee line", "default": "30-Day Feel-It Guarantee" },
    { "type": "text", "id": "note", "label": "Footnote" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FAF7F2" }
  ],
  "blocks": [ { "type": "card", "name": "Review card", "settings": [
    { "type": "image_picker", "id": "image", "label": "Before / after image (this card)" },
    { "type": "textarea", "id": "quote", "label": "Review quote", "default": "Add a real customer review here." },
    { "type": "text", "id": "name", "label": "Name", "default": "Verified Customer" }
  ] } ],
  "max_blocks": 6,
  "presets": [{ "name": "JP — Social proof split", "blocks": [ {"type":"card"},{"type":"card"},{"type":"card"} ] }]
}
{% endschema %}
