.adx-feat-img img,.adx-feat-img .adx-ph{width:62%;margin:6px auto 16px;display:block;aspect-ratio:1/1;object-fit:contain}
.adx-featlist{list-style:none;padding:0;margin:0 auto;display:flex;flex-direction:column;gap:10px;max-width:420px}
.adx-featlist li{position:relative;padding-left:28px;font-size:1rem;color:#e7e6f2}
.adx-featlist li:before{content:'✓';position:absolute;left:0;top:1px;width:19px;height:19px;border-radius:50%;background:var(--accent);color:#fff;font-size:.66rem;font-weight:800;display:flex;align-items:center;justify-content:center}
.adx-bens{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.adx-bens--4{margin:8px 0 18px}
.adx-ben{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;text-align:center}
.adx-ben-i{display:inline-flex;width:40px;height:40px;border-radius:50%;background:rgba(109,73,224,.18);color:var(--lav);align-items:center;justify-content:center;font-size:1.2rem;margin-bottom:8px}
.adx-ben b{display:block;font-size:.96rem;margin-bottom:4px}
.adx-ben p{margin:0;font-size:.8rem;color:var(--mut);line-height:1.4}
.adx-sys{display:flex;flex-direction:column;gap:12px;margin-bottom:18px}
.adx-syscard{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:6px}
.adx-syscard img,.adx-sysimg{width:84px;height:84px;border-radius:12px;object-fit:cover;background:var(--card2)}
.adx-sysimg{min-height:0;padding:0;font-size:.8rem}
.adx-syscard b{font-size:1.05rem}
.adx-syscard p{margin:0;font-size:.92rem;color:var(--mut);line-height:1.45}
.adx-vids{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.adx-vid{position:relative;border-radius:16px;overflow:hidden;border:2px solid var(--line);background:var(--card2)}
.adx-vid img{width:100%;aspect-ratio:9/16;object-fit:cover;display:block}
.adx-vid-ph{aspect-ratio:9/16}
.adx-vid-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,.92);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:1rem}
.adx-vid-cap{position:absolute;left:8px;right:8px;bottom:8px;font-size:.74rem;font-weight:700;text-shadow:0 1px 6px rgba(0,0,0,.85)}
.adx-cardbox{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px 18px}
.adx-founder{text-align:center;margin-bottom:20px}
.adx-founder img,.adx-founderimg{width:100%;border-radius:16px;margin-bottom:14px;border:1px solid var(--line)}
.adx-founderimg{aspect-ratio:4/3}
.adx-foundern{font-size:.85rem;color:var(--lav);font-weight:700;margin:10px 0 0}
.adx-seen{text-align:center;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--mut);margin:4px 0 12px}
.adx-logos img{width:100%;border-radius:12px}
.adx-reviews{display:flex;flex-direction:column;gap:12px}
.adx-rev{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:15px 16px}
.adx-rev-stars{color:#f5a623;font-size:.9rem;margin-bottom:6px}
.adx-rev p{margin:0 0 8px;font-size:1rem;line-height:1.45;font-weight:600}
.adx-rev span{font-size:.8rem;color:var(--mut)}
.adx-table{width:100%;border-collapse:collapse;font-size:.92rem}
.adx-table th,.adx-table td{border:1px solid var(--line);padding:11px 8px;text-align:center}
.adx-table th:first-child,.adx-table td:first-child{text-align:left;color:#cfcde0}
.adx-table th{background:var(--card);font-weight:800;font-size:.82rem}
.adx-table td:nth-child(2){color:var(--lav);font-weight:800}
.adx-timeline{display:flex;flex-direction:column;gap:12px}
.adx-tl{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:15px 16px}
.adx-tl-d{display:inline-block;background:rgba(109,73,224,.18);color:var(--lav);font-size:.68rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:3px 10px;border-radius:999px;margin-bottom:8px}
.adx-tl b{font-size:1.02rem;display:block;margin-bottom:3px}
.adx-tl p{margin:0;font-size:.92rem;color:var(--mut);line-height:1.45}
.adx-pdp{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start}
.adx-pdp-main img,.adx-pdp-main .adx-ph{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:14px;background:var(--card2)}
.adx-pdp-thumbs{display:flex;gap:6px;margin-top:8px}
.adx-pdp-th{flex:1;border:1px solid var(--line);border-radius:8px;overflow:hidden;aspect-ratio:1/1}
.adx-pdp-th img{width:100%;height:100%;object-fit:cover}
.adx-pdp-stars{color:#f5a623;font-size:.85rem;margin-bottom:8px}
.adx-pdp-stars span{color:var(--mut);font-size:.78rem;margin-left:4px}
.adx-pdp-title{font-size:1.15rem;font-weight:800;margin:0 0 10px;line-height:1.2}
.adx-pdp-bul{list-style:none;padding:0;margin:0 0 12px;display:flex;flex-direction:column;gap:7px}
.adx-pdp-bul li{position:relative;padding-left:22px;font-size:.9rem;color:#cfcde0}
.adx-pdp-bul li:before{content:'✓';position:absolute;left:0;color:var(--lav);font-weight:800}
.adx-pdp-proof{font-size:.8rem;font-weight:700;color:var(--lav);margin-bottom:12px}
.adx-guarantee{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;margin:24px 0}
.adx-guar-h{font-weight:800;font-size:1.05rem;margin-bottom:8px}
.adx-guarantee p{margin:0;font-size:.96rem;line-height:1.5;color:#cfcde0}
.adx-faq{display:flex;flex-direction:column;gap:10px}
.adx-faq-i{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:0 16px}
.adx-faq-i summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:10px;padding:16px 0;font-weight:700;font-size:.98rem;cursor:pointer}
.adx-faq-i summary::-webkit-details-marker{display:none}
.adx-faq-i summary span{color:var(--lav);font-size:1.3rem;font-weight:400}
.adx-faq-i[open] summary span{transform:rotate(45deg)}
.adx-faq-a{padding:0 0 16px;font-size:.95rem;color:var(--mut);line-height:1.5}
.adx-disc{font-size:.74rem;color:#76748f;line-height:1.45;margin-top:26px;text-align:center}
@media(max-width:520px){.adx-h1{font-size:1.7rem}.adx-h2{font-size:1.32rem}.adx-split{grid-template-columns:1fr}.adx-vs{grid-template-columns:1fr}.adx-pdp{grid-template-columns:1fr}.adx-hcall{font-size:.66rem}.adx-hcall-i{width:32px;height:32px}}
</style>

{% schema %}
{
  "name": "Somna Advertorial",
  "settings": [
    { "type": "url", "id": "cta_url", "label": "CTA destination (default: quiz page)" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_img", "label": "Hero / product image (defaults to product image)" },
    { "type": "image_picker", "id": "hero_testi_img", "label": "Hero testimonial avatar" },
    { "type": "text", "id": "hero_testi_q", "label": "Hero testimonial quote" },
    { "type": "text", "id": "hero_testi_n", "label": "Hero testimonial name" },
    { "type": "header", "content": "Section images (default to product images)" },
    { "type": "image_picker", "id": "problem_img", "label": "Problem image" },
    { "type": "image_picker", "id": "tried_img", "label": "Tried-everything image" },
    { "type": "image_picker", "id": "mech_img", "label": "Mechanism image" },
    { "type": "image_picker", "id": "founder_img", "label": "Founder / transformation image" },
    { "type": "text", "id": "founder_quote", "label": "Founder quote" },
    { "type": "text", "id": "founder_name", "label": "Founder name" },
    { "type": "image_picker", "id": "logos_img", "label": "As-seen-in logo strip (optional)" },
    { "type": "image_picker", "id": "kit_img", "label": "Kit / what's included image" },
    { "type": "text", "id": "proof_count", "label": "Social proof count", "default": "12,000+" },
    { "type": "text", "id": "reviews_count", "label": "Reviews count label", "default": "4,300+" }
  ],
  "blocks": [
    { "type": "ugc", "name": "UGC / video card", "settings": [ { "type": "image_picker", "id": "img", "label": "Image / thumbnail" }, { "type": "text", "id": "caption", "label": "Caption", "default": "best sleep in years" } ] },
    { "type": "result", "name": "Result card", "settings": [ { "type": "image_picker", "id": "img", "label": "Image" }, { "type": "text", "id": "caption", "label": "Caption", "default": "Down to one alarm" } ] },
    { "type": "review", "name": "Review", "settings": [ { "type": "text", "id": "quote", "label": "Quote", "default": "Genuinely the best sleep purchase I've made." }, { "type": "text", "id": "name", "label": "Name", "default": "James T." } ] },
    { "type": "faq", "name": "FAQ", "settings": [ { "type": "text", "id": "q", "label": "Question", "default": "How fast will I notice a difference?" }, { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>Most people feel calmer, quieter nights within the first couple of weeks.</p>" } ] }
  ],
  "presets": [{ "name": "Somna Advertorial", "blocks": [ { "type": "ugc" }, { "type": "ugc" }, { "type": "ugc" }, { "type": "ugc" }, { "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "result" }, { "type": "result" }, { "type": "faq" }, { "type": "faq" }, { "type": "faq" }, { "type": "faq" } ] }]
}
{% endschema %}
