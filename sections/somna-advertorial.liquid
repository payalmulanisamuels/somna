.adx-quote{border-left:3px solid var(--accent);background:var(--card);padding:16px 18px;border-radius:0 12px 12px 0;font-size:1.08rem;font-weight:700;font-style:italic;line-height:1.4;margin:6px 0 0}
.adx-vs{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
