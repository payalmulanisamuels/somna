    {% if img_mech %}<img class="adx-img" src="{{ img_mech | image_url: width: 1000 }}" alt="">{% endif %}

    <div class="adx-rule"></div>

    <h2 class="adx-h2">Say no to louder alarms &amp; sleeping-pill hangovers</h2>
