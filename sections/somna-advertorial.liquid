<style>
.shopify-section-group-header-group,.shopify-section-group-footer-group{display:none !important}
#somna-adx{--bg:#0d0d1c;--card:#16162b;--card2:#1d1d36;--ink:#fff;--mut:#9a98b5;--accent:#6D49E0;--lav:#98A3DE;--line:#2a2a45;font-family:'Hanken Grotesk',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);color:var(--ink)}
.adx-bar{background:var(--accent);color:#fff;text-align:center;font-size:.76rem;font-weight:800;padding:9px 14px}
.adx-bar a{color:#fff;text-decoration:underline}
.adx-wrap{max-width:640px;margin:0 auto;padding:24px 18px 70px}
.adx-kick{font-size:.72rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--lav);margin:0 0 12px}
.adx-h1{font-size:2.1rem;line-height:1.12;font-weight:800;text-transform:uppercase;letter-spacing:-.02em;margin:0 0 14px}
.adx-h1 span{color:var(--lav)}
.adx-dek{font-size:1.06rem;line-height:1.5;color:var(--mut);margin:0 0 20px}
.adx-hero2{position:relative;background:radial-gradient(circle at 50% 35%,rgba(109,73,224,.45),rgba(13,13,28,0) 62%);border:1px solid var(--line);border-radius:20px;padding:30px 14px 18px;margin-bottom:16px;overflow:hidden}
.adx-hero2-badges{display:flex;justify-content:space-between;margin-bottom:6px}
.adx-hero2-badges span{background:rgba(255,255,255,.08);border:1px solid var(--line);color:#fff;font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;padding:4px 9px;border-radius:999px}
.adx-hero2-row{display:grid;grid-template-columns:1fr 1.3fr 1fr;gap:6px;align-items:center}
.adx-hcol{display:flex;flex-direction:column;gap:18px}
.adx-hcall{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;font-size:.72rem;font-weight:700;line-height:1.2}
.adx-hcall-i{width:36px;height:36px;border-radius:50%;background:rgba(13,13,28,.6);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--lav);font-size:1.05rem}
.adx-hero2-imgwrap img,.adx-hero2-ph{width:100%;aspect-ratio:1/1;object-fit:contain;border-radius:14px}
.adx-hero2-ph{min-height:0}
.adx-ph{background:var(--card2);border:1px dashed #3a3a5c;border-radius:16px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--mut);font-size:.82rem;padding:16px;min-height:110px}
.adx-cta{display:block;text-align:center;background:var(--accent);color:#fff;text-decoration:none;border-radius:999px;padding:18px 20px;font-size:1.05rem;font-weight:800;box-shadow:0 8px 24px rgba(109,73,224,.4);transition:background .15s,transform .06s}
.adx-cta:hover{background:#7d5ce8}.adx-cta:active{transform:scale(.99)}
.adx-cta-sub{text-align:center;font-size:.82rem;color:var(--mut);margin:9px 0 0;font-weight:600}
.adx-herotesti{display:flex;gap:12px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:13px;margin-top:16px}
.adx-herotesti img,.adx-av{width:44px;height:44px;border-radius:50%;object-fit:cover;flex:0 0 auto}
.adx-av{background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800}
.adx-herotesti p{margin:0 0 3px;font-size:.88rem;font-style:italic;line-height:1.35}
.adx-herotesti span{font-size:.76rem;color:var(--lav);font-weight:600}
.adx-rule{height:1px;background:var(--line);margin:34px 0}
.adx-warn{font-size:.74rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--lav);margin:0 0 10px}
.adx-h2{font-size:1.55rem;line-height:1.18;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;margin:0 0 16px}
.adx-center{text-align:center}
.adx-p{font-size:1.04rem;line-height:1.6;color:#cfcde0;margin:0 0 16px}
.adx-p em{font-style:italic}
.adx-split{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:center;margin-bottom:16px}
.adx-splitimg{width:100%;border-radius:14px;border:1px solid var(--line)}
.adx-splitimg.adx-ph{aspect-ratio:3/4}
.adx-xlist{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
