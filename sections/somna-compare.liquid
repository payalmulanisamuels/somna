<section class="somna-cmp">
  <div class="sc-wrap">
    <div class="sc-head somna-sr"><span class="sc-kicker">{{ section.settings.kicker | default: 'Why Somna' }}</span><h2 class="sc-title">{{ section.settings.title | default: 'Somna vs. ordinary strips' }}</h2></div>
    <div class="sc-table somna-sr">
      <div class="sc-row sc-hrow">
        <div class="sc-feat"></div>
        <div class="sc-col sc-us">{{ section.settings.col_us | default: 'Somna' }}</div>
        <div class="sc-col sc-them">{{ section.settings.col_them | default: 'Others' }}</div>
      </div>
      {%- for block in section.blocks -%}
        <div class="sc-row" {{ block.shopify_attributes }}>
          <div class="sc-feat">{{ block.settings.label }}</div>
          <div class="sc-col sc-us">{%- if block.settings.us == 'yes' -%}<span class="sc-yes">✓</span>{%- elsif block.settings.us == 'no' -%}<span class="sc-no">✕</span>{%- else -%}{{ block.settings.us }}{%- endif -%}</div>
          <div class="sc-col sc-them">{%- if block.settings.them == 'yes' -%}<span class="sc-yes">✓</span>{%- elsif block.settings.them == 'no' -%}<span class="sc-no">✕</span>{%- else -%}{{ block.settings.them }}{%- endif -%}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
.somna-cmp{background:#0f0f1c;color:#fff;padding:60px 18px;font-family:'Hanken Grotesk',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.sc-wrap{max-width:720px;margin:0 auto}
.sc-head{text-align:center;margin-bottom:26px}
.sc-kicker{color:#98A3DE;font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.sc-title{font-size:1.85rem;font-weight:800;letter-spacing:-.01em;margin:8px 0 0}
.sc-table{border-radius:16px;overflow:hidden;border:1px solid #26263f}
.sc-row{display:grid;grid-template-columns:1.7fr 1fr 1fr;align-items:center}
.sc-row+.sc-row{border-top:1px solid #20203a}
.sc-hrow{background:#17172c}
.sc-feat{padding:15px 16px;font-weight:600;font-size:.92rem;color:#d7d7e6}
.sc-col{padding:15px;text-align:center;font-weight:800;font-size:1.02rem}
.sc-hrow .sc-feat{color:#8a8aa5;font-size:.8rem}
.sc-hrow .sc-col{font-size:.82rem;letter-spacing:.04em;text-transform:uppercase}
.sc-us{background:rgba(109,73,224,.16);color:#fff}
.sc-hrow .sc-us{background:#6D49E0;color:#fff}
.sc-them{color:#8a8aa5}
.sc-yes{color:#57e08c}
.sc-no{color:#e06b6b}
@media(max-width:520px){.sc-feat{font-size:.8rem;padding:13px 10px}.sc-col{padding:13px 6px;font-size:.9rem}.sc-title{font-size:1.45rem}}
</style>
{% schema %}
{
  "name": "Somna Compare",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why Somna" },
    { "type": "text", "id": "title", "label": "Title", "default": "Somna vs. ordinary strips" },
    { "type": "text", "id": "col_us", "label": "Your column label", "default": "Somna" },
    { "type": "text", "id": "col_them", "label": "Their column label", "default": "Others" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "label", "label": "Feature", "default": "Feature" },
      { "type": "text", "id": "us", "label": "Somna cell (yes / no / text)", "default": "yes" },
      { "type": "text", "id": "them", "label": "Others cell (yes / no / text)", "default": "no" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Somna Compare", "blocks": [ {"type":"row"},{"type":"row"},{"type":"row"},{"type":"row"},{"type":"row"} ] }]
}
{% endschema %}
