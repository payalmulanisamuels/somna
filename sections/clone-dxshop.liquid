<script>
(function(){
  function sheet(id){return document.getElementById(id);}
  function openSheet(s){if(!s)return;s.classList.add('open');document.body.style.overflow='hidden';}
  function closeSheet(s){if(!s)return;s.classList.remove('open');document.body.style.overflow='';}
  var sortBtn=document.getElementById('dxOpenSort'),sortSheet=sheet('dxSortSheet');
  var filterBtn=document.getElementById('dxOpenFilter'),filterSheet=sheet('dxFilterSheet');
  if(sortBtn)sortBtn.addEventListener('click',function(){openSheet(sortSheet);});
  if(filterBtn)filterBtn.addEventListener('click',function(){openSheet(filterSheet);});
  document.querySelectorAll('.dxsh-ov').forEach(function(ov){
    ov.addEventListener('click',function(e){if(e.target===ov)closeSheet(ov);});
    ov.querySelectorAll('[data-close]').forEach(function(b){b.addEventListener('click',function(){closeSheet(ov);});});
  });
  document.querySelectorAll('.dxsh-opt').forEach(function(o){o.addEventListener('click',function(){var u=new URL(window.location);u.searchParams.set('sort_by',o.getAttribute('data-sort'));window.location=u.toString();});});
})();
</script>
