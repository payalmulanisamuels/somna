{{ 'somna-jp-styles.css' | asset_url | stylesheet_tag }}
<section class="sjp" style="background:{{ section.settings.bg | default: '#FAF7F2' }}">
  <div class="sjp-tl">
    <div class="sjp-tl-img somna-zoomin{% if section.settings.mobile_image != blank %} sjp-tl-hasm{% endif %}">
      {%- if section.settings.image != blank -%}<img class="sjp-tl-imgd" src="{{ section.settings.image | image_url: width: 1400 }}" loading="lazy" alt="{{ section.settings.title_a | escape }}">{%- endif -%}
      {%- if section.settings.mobile_image != blank -%}<img class="sjp-tl-imgm" src="{{ section.settings.mobile_image | image_url: width: 1000 }}" loading="lazy" alt="{{ section.settings.title_a | escape }}">{%- endif -%}
      {%- if section.settings.image == blank and section.settings.mobile_image == blank -%}<div class="sjp-ph">Insert lifestyle photo (person + product)</div>{%- endif -%}
      <span class="sjp-tl-fade" style="background:linear-gradient(90deg,rgba(255,255,255,0) 55%,{{ section.settings.bg | default: '#FAF7F2' }} 100%)"></span>
    </div>
    <div class="sjp-tl-body somna-sr">
      <h2 class="sjp-tl-t">{{ section.settings.title_a | default: "It's time to feel… so much" }} <em>{{ section.settings.title_em | default: 'better' }}</em></h2>
      <div class="sjp-tl-list somna-sr-stag">
        {%- for block in section.blocks -%}
        <div class="sjp-tl-item{% if forloop.last %} is-last{% endif %}" {{ block.shopify_attributes }}>
          <span class="sjp-tl-pill">{{ block.settings.pill }}</span>
          <b>{{ block.settings.title }}</b>
          <p>{{ block.settings.body }}</p>
        </div>
        {%- endfor -%}
      </div>
      <div class="sjp-tl-cta">
        <a class="sjp-cta" href="{{ section.settings.cta_url | default: '#cda-buy' }}">{{ section.settings.cta | default: 'Try Somna Tonight' }} →</a>
        {%- if section.settings.gline != blank -%}<div class="sjp-gline" style="justify-content:flex-start"><span class="sjp-gdot">✓</span>{{ section.settings.gline }}</div>{%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>
.sjp-tl{display:grid;grid-template-columns:1.05fr .95fr;align-items:center}
.sjp-tl-img{position:relative;min-height:480px;height:100%}
.sjp-tl-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.sjp-tl-imgm{display:none}
.sjp-tl-img .sjp-ph{position:absolute;inset:0}
.sjp-tl-fade{position:absolute;inset:0;pointer-events:none}
.sjp-tl-body{padding:clamp(36px,5.5vw,84px) clamp(24px,5vw,96px)}
.sjp-tl-t{font-family:'Lora',Georgia,serif;font-weight:600;font-size:clamp(1.5rem,3vw,2rem);letter-spacing:-.01em;line-height:1.18;margin:0 0 26px;color:var(--ink)}
.sjp-tl-t em{font-style:italic;color:var(--band)}
.sjp-tl-item{position:relative;padding:0 0 24px 24px;border-left:2px solid #E4DCCB}
.sjp-tl-item.is-last{border-left-color:transparent}
.sjp-tl-item:before{content:'';position:absolute;left:-6px;top:2px;width:10px;height:10px;border-radius:50%;background:var(--band)}
.sjp-tl-pill{display:inline-block;border:1.5px dashed var(--band);color:var(--band);font-weight:800;font-size:.64rem;letter-spacing:.06em;text-transform:uppercase;padding:3px 11px;border-radius:999px;margin-bottom:8px;background:#fff}
.sjp-tl-item b{display:block;font-family:'Lora',Georgia,serif;font-style:italic;font-weight:600;font-size:1.02rem;letter-spacing:-.01em;color:var(--ink);margin-bottom:5px}
.sjp-tl-item p{margin:0;font-size:.8rem;line-height:1.55;color:var(--mut);max-width:420px}
.sjp-tl-cta{margin-top:24px}
@media(max-width:860px){.sjp-tl{grid-template-columns:1fr}.sjp-tl-img{min-height:300px;aspect-ratio:4/3;height:auto}.sjp-tl-hasm .sjp-tl-imgd{display:none}.sjp-tl-hasm .sjp-tl-imgm{display:block}.sjp-tl-fade{display:none}.sjp-tl-body{padding:30px 20px 44px}}
</style>
{% schema %}
{
  "name": "JP — Timeline split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Left image (blends into right side)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional — replaces left image on phones)" },
    { "type": "text", "id": "title_a", "label": "Title", "default": "It's time to feel… so much" },
    { "type": "text", "id": "title_em", "label": "Italic accent", "default": "better" },
    { "type": "text", "id": "cta", "label": "CTA label", "default": "Try Somna Tonight" },
    { "type": "url", "id": "cta_url", "label": "CTA link (default: buy box)" },
    { "type": "text", "id": "gline", "label": "Guarantee line", "default": "30-Day Feel-It Guarantee" },
    { "type": "color", "id": "bg", "label": "Background (image fades into this)", "default": "#FAF7F2" }
  ],
  "blocks": [ { "type": "step", "name": "Timeline step", "settings": [
    { "type": "text", "id": "pill", "label": "Pill label", "default": "Night 1" },
    { "type": "text", "id": "title", "label": "Headline (serif italic)", "default": "Breathe easier from the first night." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The lift is immediate — airflow opens the moment the strip settles in." }
  ] } ],
  "max_blocks": 6,
  "presets": [{ "name": "JP — Timeline split", "blocks": [ {"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"} ] }]
}
{% endschema %}
