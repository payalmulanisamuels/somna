{{ 'clone-dreamx-alarm-styles.css' | asset_url | stylesheet_tag }}
{%- assign cur = product.selected_or_first_available_variant -%}
{%- assign fid = 'spdp-' | append: section.id -%}
<section class="cda-section spdp" id="cda-buy"><div class="cda-wrap"><div class="spdp-grid">
  <div class="spdp-media">
    {%- if product.media.size > 0 -%}
      <div class="spdp-main cda-ph" id="{{ fid }}-main"><img src="{{ product.featured_media | image_url: width: 1100 }}" alt="{{ product.title | escape }}" width="1100" height="1100" loading="eager"><button type="button" class="spdp-gnav spdp-gnav-l" data-gprev aria-label="Previous image">‹</button><button type="button" class="spdp-gnav spdp-gnav-r" data-gnext aria-label="Next image">›</button>{% if section.settings.hero_badge != blank %}<span class="spdp-hbadge">{{ section.settings.hero_badge }}</span>{% endif %}</div>
      <div class="spdp-thumbs">{%- for m in product.media limit: 6 -%}<button class="cda-ph" data-spdp-thumb="{{ m | image_url: width: 1100 }}"><img src="{{ m | image_url: width: 240 }}" alt="" width="240" height="240" loading="lazy"></button>{%- endfor -%}</div>
    {%- else -%}
      <div class="spdp-main cda-ph" data-label="Main image — upload in Products › Media"></div>
      <div class="spdp-thumbs"><div class="cda-ph" data-label="1:1"></div><div class="cda-ph" data-label="1:1"></div><div class="cda-ph" data-label="1:1"></div><div class="cda-ph" data-label="1:1"></div></div>
    {%- endif -%}
  </div>
  <div class="spdp-buy">
    <div class="spdp-herocard">
    <div class="spdp-rate"><span class="cda-stars">★★★★★</span> <strong>{{ section.settings.rating }}</strong> <span class="cda-muted">· {{ section.settings.reviews }} reviews</span></div>
    <div class="spdp-kick">{{ section.settings.kicker }}</div>
    <h1 class="spdp-h1">{{ section.settings.head_a }} <span class="spdp-accent">{{ section.settings.head_b }}</span></h1>
    <div class="spdp-sub">{{ section.settings.subhead }}</div>
    {%- assign pills = section.settings.pills | split: ',' -%}
    <div class="spdp-pills">{%- for p in pills -%}<span>✓ {{ p | strip }}</span>{%- endfor -%}</div>
    <div class="spdp-card">
      <div class="spdp-card-h">{{ section.settings.why_title }}</div>
      <p class="cda-muted" style="margin:0 0 14px">{{ section.settings.why_body }}</p>
      {%- assign checks = section.settings.checks | newline_to_br | split: '<br />' -%}
      <ul class="spdp-checks">{%- for c in checks -%}{%- assign ct = c | strip -%}{% if ct != '' %}<li>{{ ct }}</li>{% endif %}{%- endfor -%}</ul>
    </div>
    {%- assign bandv = product.selected_or_first_available_variant -%}
    {%- assign nasalp = all_products['dreamx-anti-snore-nasal-strips'] -%}{%- assign nasalv = nasalp.selected_or_first_available_variant -%}
    {%- assign tapep = all_products['dreamx-sleep-mouth-tape'] -%}{%- assign tapev = tapep.selected_or_first_available_variant -%}
    {%- assign nSubC = nasalp.price | times: 0.8 -%}{%- assign tSubC = tapep.price | times: 0.8 -%}
    {%- assign today1 = bandv.price | divided_by: 100.0 -%}
    {%- assign today2C = bandv.price | plus: nSubC -%}{%- assign today2 = today2C | divided_by: 100.0 -%}
    {%- assign today3C = today2C | plus: tSubC -%}{%- assign today3 = today3C | divided_by: 100.0 -%}
    {%- assign renew3C = nSubC | plus: tSubC -%}
    <div class="spdp-label">Choose your sleep solution</div>
    <div class="spdp-opts" id="{{ fid }}-opts">
      <label class="spdp-opt spdp-opt-sub sel" data-bundle data-items="{{ bandv.id }},{{ nasalv.id }}|5928681703" data-base="79" data-code="ALARMPOP" data-name="Alarm Band + Monthly Nasal Strips" data-img="{% if section.settings.opt_pop_img != blank %}{{ section.settings.opt_pop_img | image_url: width: 1100 }}{% else %}{{ product.featured_media | image_url: width: 1100 }}{% endif %}"><span class="spdp-opt-top"><span class="spdp-radio"></span><strong>🔥 Alarm Band + Monthly Nasal Strips</strong><span class="spdp-pop">MOST POPULAR</span></span><span class="spdp-opt-price" data-price></span><span class="spdp-opt-renew">then {{ nSubC | money }} every 30 days</span><span class="spdp-opt-desc">Sleep deeper and breathe easier.</span><ul class="spdp-perks"><li>Alarm Band (one-time purchase)</li><li>Fresh Nasal Strips delivered every 30 days</li><li>Better airflow during sleep</li><li>Reduced snoring support</li><li>Save 15%</li><li>Cancel anytime</li></ul><span class="spdp-opt-fine">Alarm Band ships once. Nasal Strips automatically renew every 30 days.</span></label>
      <label class="spdp-opt" data-bundle data-items="{{ bandv.id }},{{ nasalv.id }}|5928681703,{{ tapev.id }}|5928681703" data-base="89" data-code="ALARMSYS" data-name="Complete Sleep System Membership" data-img="{% if section.settings.opt_sys_img != blank %}{{ section.settings.opt_sys_img | image_url: width: 1100 }}{% else %}{{ product.featured_media | image_url: width: 1100 }}{% endif %}"><span class="spdp-opt-top"><span class="spdp-radio"></span><strong>⭐ Complete Sleep System Membership</strong><span class="spdp-best">BEST VALUE</span></span><span class="spdp-opt-price" data-price></span><span class="spdp-opt-renew">then {{ renew3C | money }} every 30 days</span><span class="spdp-opt-desc">Everything you need for better sleep.</span><ul class="spdp-perks"><li>Alarm Band (one-time purchase)</li><li>Nasal Strips delivered every 30 days</li><li>Mouth Tape delivered every 30 days</li><li>Better airflow</li><li>Reduced snoring support</li><li>Mouth breathing support</li><li>Save 20%</li><li>Cancel anytime</li></ul><span class="spdp-opt-fine">Alarm Band ships once. Sleep essentials automatically renew every 30 days.</span></label>
      <label class="spsb-once" data-bundle data-items="{{ bandv.id }}" data-base="{{ bandv.price | divided_by: 100.0 }}" data-name="Alarm Band" data-img="{% if section.settings.opt_band_img != blank %}{{ section.settings.opt_band_img | image_url: width: 1100 }}{% else %}{{ product.featured_media | image_url: width: 1100 }}{% endif %}"><span class="spsb-once-inner"><span class="spdp-radio"></span><span class="spsb-once-copy"><span class="spsb-once-t">One-time — Alarm Band only</span><span class="spsb-once-meta">{{ bandv.price | money }} · + $9 shipping</span></span><span class="spsb-once-badge">No subscription</span></span></label>
    </div>
        <button class="cda-btn spdp-cta" id="{{ fid }}-cta">Add to cart — <span data-spdp-cta-price></span></button>
    <div class="cda-trust">🔒 Secure checkout · {{ section.settings.guarantee }}</div>
    <div class="spdp-pays"><span>VISA</span><span>MC</span><span>AMEX</span><span>PayPal</span><span>G Pay</span></div>

    {%- assign tlist = section.settings.trust_items | newline_to_br | split: '<br />' -%}
    {% if section.settings.trust_items != blank %}<ul class="spdp-trust">{%- for t in tlist -%}{%- assign tt = t | strip -%}{% if tt != '' %}<li>{{ tt }}</li>{% endif %}{%- endfor -%}</ul>{% endif %}
    

    </div>

    {%- assign hasfaq = false -%}{%- for b in section.blocks -%}{%- if b.type == 'faq' -%}{%- assign hasfaq = true -%}{%- endif -%}{%- endfor -%}
    {%- if hasfaq -%}
    <div class="spdp-faq">
      <div class="spdp-faq-h">{{ section.settings.faq_title }}</div>
      <div class="cda-acc">{%- for block in section.blocks -%}{%- if block.type == 'faq' -%}<details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}<span class="cda-ic">+</span></summary><div class="cda-ans">{{ block.settings.a }}</div></details>{%- endif -%}{%- endfor -%}</div>
    </div>
    {%- endif -%}

    {%- assign hasaddon = false -%}{%- for b in section.blocks -%}{%- if b.type == 'addon' -%}{%- assign hasaddon = true -%}{%- endif -%}{%- endfor -%}
    {%- if hasaddon -%}
    <div class="spdp-sys">
      <h3>{{ section.settings.sys_title }}</h3>
      <p class="cda-muted" style="margin:2px 0 0">{{ section.settings.sys_sub }}</p>
      {%- for block in section.blocks -%}{%- if block.type == 'addon' -%}{%- assign ap = block.settings.prod -%}
        <div class="spdp-addon" {{ block.shopify_attributes }}>
          {% if ap != blank and ap.featured_image %}<div class="cda-ph"><img src="{{ ap.featured_image | image_url: width: 160 }}" alt="" width="160" height="160"></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %}
          <div><div class="spdp-an">{{ ap.title | default: block.settings.name }}</div><div class="cda-muted" style="font-size:.84rem">{{ block.settings.desc }}</div><div class="spdp-ap">{% if ap != blank %}{{ ap.price | money }}{% else %}{{ block.settings.price }}{% endif %}</div>{% if ap != blank %}{% render 'somna-plan-select', variant: ap.selected_or_first_available_variant, id_prefix: block.id %}{% endif %}</div>
          {% if ap != blank %}<button class="spdp-add" data-spdp-add="{{ ap.selected_or_first_available_variant.id }}">Add +</button>{% else %}<a class="spdp-add" href="{{ block.settings.link | default: '/' }}">Add +</a>{% endif %}
        </div>
      {%- endif -%}{%- endfor -%}
    </div>
    {%- endif -%}

    <div class="spdp-inc">
      <div class="spdp-inc-h">{{ section.settings.inc_title }}</div>
      {%- assign incs = section.settings.inc_bullets | newline_to_br | split: '<br />' -%}
      <ul>{%- for i in incs -%}{%- assign it = i | strip -%}{% if it != '' %}<li>{{ it }}</li>{% endif %}{%- endfor -%}</ul>
      {% if section.settings.inc_note != blank %}<p class="spdp-inc-note">{{ section.settings.inc_note }}</p>{% endif %}
    </div>

    {%- assign badges = section.settings.badges | split: ',' -%}
    <div class="spdp-badges">{%- for b in badges -%}<span>{{ b | strip }}</span>{%- endfor -%}</div>

    {%- assign hasvid = false -%}{%- for b in section.blocks -%}{%- if b.type == 'vid' -%}{%- assign hasvid = true -%}{%- endif -%}{%- endfor -%}
    {%- if hasvid -%}
    <div class="spdp-testi">
      <div class="spdp-testi-h">{{ section.settings.testi_title }} <span class="cda-muted" style="font-weight:500">· tap to play</span></div>
      <div class="spdp-testi-wrap">
        <button type="button" class="spdp-tarr spdp-tarr-l" data-spdp-tprev aria-label="Previous">‹</button>
        <div class="spdp-testi-row" id="{{ fid }}-trow">{%- for block in section.blocks -%}{%- if block.type == 'vid' -%}
          {%- if block.settings.vid != blank -%}<div class="spdp-tcard" {{ block.shopify_attributes }}><video class="spdp-tv" playsinline controls preload="none"{% if block.settings.image != blank %} poster="{{ block.settings.image | image_url: width: 600 }}"{% endif %}>{%- for source in block.settings.vid.sources -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endfor -%}</video><span class="spdp-tcap">{{ block.settings.caption }}</span></div>
          {%- elsif block.settings.url != blank -%}<a class="spdp-tcard" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="cda-ph"><img src="{{ block.settings.image | image_url: width: 600 }}" alt=""></div>{% else %}<div class="cda-ph" data-label="Video"></div>{% endif %}<span class="spdp-tplay">▶</span><span class="spdp-tcap">{{ block.settings.caption }}</span></a>
          {%- else -%}<div class="spdp-tcard" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="cda-ph"><img src="{{ block.settings.image | image_url: width: 600 }}" alt=""></div>{% else %}<div class="cda-ph" data-label="Upload a video"></div>{% endif %}<span class="spdp-tcap">{{ block.settings.caption }}</span></div>
          {%- endif -%}
        {%- endif -%}{%- endfor -%}</div>
        <button type="button" class="spdp-tarr spdp-tarr-r" data-spdp-tnext aria-label="Next">›</button>
      </div>
    </div>
    {%- endif -%}
  </div>
</div></div>
  <div class="spdp-sticky" data-spsb-sticky>
    <button type="button" class="spdp-sticky-sel" data-spsb-stickysel aria-haspopup="true"><span class="spdp-sticky-txt"><span class="spdp-sticky-name" data-spsb-stickyname></span><span class="spdp-sticky-price" data-spsb-stickyprice></span></span><i class="spdp-sticky-car">▾</i></button>
    <button type="button" class="spdp-sticky-cta" id="{{ fid }}-stickycta">ADD TO CART</button>
    <div class="spdp-sticky-menu" data-spsb-stickymenu></div>
  </div>
</section>
<style>
.spdp .cda-wrap{max-width:1120px}
.spdp-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
.spdp-media{position:sticky;top:80px}
.spdp-main{margin-bottom:10px}
.spdp-thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
.spdp-thumbs button{border:2px solid #111129;border-radius:9px;padding:0;cursor:pointer;background:none;overflow:hidden}.spdp-thumbs button.sel{box-shadow:0 0 0 2px #111129}.spdp-thumbs button:hover{box-shadow:0 0 0 2px rgba(17,17,41,.2)}
.spdp-rate{display:flex;align-items:center;gap:8px;font-size:.92rem}
.spdp-kick{text-transform:uppercase;letter-spacing:.1em;font-size:.72rem;font-weight:800;color:var(--cda-accent);margin:14px 0 6px}
.spdp-h1{font-size:clamp(2rem,4.4vw,3rem);font-weight:800;line-height:1.02;letter-spacing:-.02em;margin:0 0 12px;text-transform:uppercase}
.spdp-accent{color:var(--cda-accent)}
.spdp-sub{color:var(--cda-muted);font-size:1.02rem;margin-bottom:16px}
.spdp-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.spdp-pills span{background:var(--cda-soft);color:var(--cda-accent-d);font-weight:700;font-size:.76rem;padding:5px 11px;border-radius:999px}
.spdp-card{border:1px solid var(--cda-line);border-radius:16px;padding:20px;margin-bottom:22px}
.spdp-card-h{font-weight:800;text-transform:uppercase;letter-spacing:.04em;font-size:.8rem;color:var(--cda-accent);margin-bottom:10px}
.spdp-checks{list-style:none;margin:0;padding:0;display:grid;gap:9px}
.spdp-checks li{padding-left:26px;position:relative;font-weight:500;font-size:.95rem}
.spdp-checks li:before{content:'✓';position:absolute;left:0;color:#fff;background:var(--cda-accent);width:18px;height:18px;border-radius:50%;font-size:.7rem;display:flex;align-items:center;justify-content:center;top:2px}
.spdp-label{font-size:.74rem;text-transform:uppercase;letter-spacing:.1em;font-weight:800;color:var(--cda-muted);margin:0 0 10px}
.spdp-sets{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:22px}
.spdp-set{border:1.5px solid var(--cda-line);background:#fff;border-radius:12px;padding:10px 16px;cursor:pointer;text-align:left;font:inherit;display:flex;flex-direction:column}
.spdp-set.sel{border-color:var(--cda-accent);background:var(--cda-soft)}
.spdp-set-n{font-weight:700;font-size:.92rem}
.spdp-set-s{font-size:.78rem;color:var(--cda-muted)}
.spdp-set-p{font-size:.84rem;font-weight:800;color:var(--cda-accent-d);margin-top:3px}
.spdp-opts{display:grid;gap:12px;margin-bottom:18px}
.spdp-opt{display:block;border:1.5px solid var(--cda-line);border-radius:14px;padding:16px;cursor:pointer}
.spdp-opt.sel{border-color:var(--cda-accent);box-shadow:0 0 0 3px var(--cda-soft),0 6px 20px rgba(109,73,224,.12)}
.spdp-opt-sub.sel{background:linear-gradient(180deg,#fff,var(--cda-soft))}
.spdp-opt-top{display:flex;align-items:center;gap:10px;font-size:1rem}
.spdp-radio{width:18px;height:18px;border-radius:50%;border:2px solid #cfccdb;flex:0 0 auto}
.spdp-opt.sel .spdp-radio{border-color:var(--cda-accent);background:radial-gradient(circle,var(--cda-accent) 0 5px,#fff 6px)}
.spdp-best{margin-left:auto;background:#1b8a5a;color:#fff;font-size:.6rem;font-weight:800;letter-spacing:.06em;padding:3px 8px;border-radius:999px}
.spdp-opt-price{display:block;font-size:1.5rem;font-weight:800;margin:8px 0 2px}
.spdp-opt-price s{font-size:.95rem;color:var(--cda-muted);font-weight:500;margin-left:6px}
.spdp-perks{list-style:none;margin:6px 0 0;padding:0;display:grid;gap:5px;font-size:.84rem;color:var(--cda-muted)}
.spdp-perks li:before{content:'✓ ';color:var(--cda-accent);font-weight:800}
.spdp-dim li:before{content:'✕ ';color:#c3bfd2}
.spdp-cta{margin-top:4px}
.spdp-pays{display:flex;gap:6px;justify-content:center;margin-top:14px}
.spdp-pays span{border:1px solid var(--cda-line);border-radius:6px;padding:3px 8px;font-size:.66rem;font-weight:700;color:var(--cda-muted)}
.spdp-trust{list-style:none;margin:18px 0 0;padding:16px 18px;background:var(--cda-soft);border-radius:14px;display:grid;grid-template-columns:1fr 1fr;gap:9px 16px}
.spdp-trust li{position:relative;padding-left:24px;font-size:.84rem;font-weight:600;color:var(--cda-ink);line-height:1.3}
.spdp-trust li:before{content:'✓';position:absolute;left:0;top:1px;color:#fff;background:var(--cda-accent);width:17px;height:17px;border-radius:50%;font-size:.64rem;display:flex;align-items:center;justify-content:center}
.spdp-proof{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-top:14px;justify-content:center;font-size:.9rem}
.spdp-proof .cda-stars{font-size:.95rem}
.spdp-proof-line{width:100%;text-align:center;color:var(--cda-muted);font-weight:600;font-size:.84rem;margin-top:2px}
.spdp-faq{margin-top:28px}
.spdp-faq-h{font-weight:800;font-size:1.1rem;margin-bottom:6px}
.spdp-sys{margin-top:28px}
.spdp-sys h3{font-size:1.15rem;font-weight:800;margin:0}
.spdp-addon{display:flex;align-items:center;gap:12px;border:1px solid var(--cda-line);border-radius:14px;padding:12px;margin-top:12px;flex-wrap:wrap}
.spdp-addon>div:nth-child(2){flex:1;min-width:140px}
.spdp-addon .cda-ph{width:60px;height:60px;flex:0 0 auto;border-radius:10px}
.spdp-an{font-weight:700;font-size:.95rem}
.spdp-ap{font-weight:700;color:var(--cda-accent-d);margin-top:2px}
.spdp-add{margin-left:auto;background:#1b8a5a;color:#fff;border:none;border-radius:999px;padding:9px 16px;font-weight:700;cursor:pointer;flex:0 0 auto;text-decoration:none;font-size:.85rem}
.spdp-inc{background:var(--cda-soft);border-radius:14px;padding:18px;margin-top:22px}
.spdp-inc-h{font-weight:800;margin-bottom:10px}
.spdp-inc ul{list-style:none;margin:0;padding:0;display:grid;gap:8px;font-weight:600;font-size:.92rem}
.spdp-inc li:before{content:'✓ ';color:var(--cda-accent);font-weight:800}
.spdp-inc-note{font-size:.8rem;color:var(--cda-muted);margin-top:10px}
.spdp-badges{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:18px}
.spdp-badges span{border:1px solid var(--cda-line);border-radius:999px;padding:5px 12px;font-size:.74rem;font-weight:700;color:var(--cda-muted)}
.spdp-testi{margin-top:28px}
.spdp-testi-h{font-weight:800;margin-bottom:12px}
.spdp-testi-wrap{position:relative}
.spdp-testi-row{display:flex;gap:14px;overflow-x:auto;scroll-behavior:smooth;scroll-snap-type:x mandatory;padding-bottom:6px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.spdp-testi-row::-webkit-scrollbar{display:none}
.spdp-tcard{position:relative;flex:0 0 200px;scroll-snap-align:start;border-radius:16px;overflow:hidden;text-decoration:none;color:#fff;background:var(--cda-ink)}
.spdp-tcard .cda-ph{aspect-ratio:9/16;border-radius:16px;background:var(--cda-ink)}
.spdp-tcard .cda-ph img{width:100%;height:100%;object-fit:cover}
.spdp-tv{width:100%;aspect-ratio:9/16;object-fit:cover;border-radius:16px;background:var(--cda-ink);display:block}
.spdp-tplay{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.92);color:var(--cda-accent);display:flex;align-items:center;justify-content:center;font-size:1rem}
.spdp-tcap{position:absolute;left:10px;right:10px;bottom:10px;font-size:.78rem;font-weight:700;text-shadow:0 1px 6px rgba(0,0,0,.7);pointer-events:none}
.spdp-tarr{position:absolute;top:calc(50% - 19px);width:38px;height:38px;border-radius:50%;background:#fff;border:1px solid var(--cda-line);box-shadow:0 4px 14px rgba(20,18,40,.18);color:var(--cda-ink);font-size:1.4rem;line-height:1;cursor:pointer;z-index:3;display:flex;align-items:center;justify-content:center}
.spdp-tarr:hover{background:var(--cda-soft);border-color:var(--cda-accent)}
.spdp-tarr-l{left:-12px}
.spdp-tarr-r{right:-12px}
#shopify-section-{{ section.id }} h1{color:var(--cda-ink)}
@media(max-width:860px){.spdp-grid{grid-template-columns:1fr;gap:28px}.spdp-media{position:static}}
@media(max-width:560px){.spdp-cta{width:100%}.spdp-trust{grid-template-columns:1fr}.spdp-sets{gap:8px}.spdp-set{flex:1;min-width:96px}.spdp-opt-price{font-size:1.3rem}.spdp-h1{font-size:clamp(1.7rem,8vw,2.2rem)}.spdp-testi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;overflow:visible;scroll-snap-type:none}.spdp-tcard{flex:1 1 auto;border-radius:12px}.spdp-tcard .cda-ph,.spdp-tv{border-radius:12px}.spdp-tcap{left:6px;right:6px;bottom:6px;font-size:.62rem}.spdp-tarr{display:none}}

/* gallery arrows */
.spdp-main{position:relative}
.spdp-gnav{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;border:2px solid #111129;background:rgba(255,255,255,.96);color:var(--cda-ink);font-size:1.5rem;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:4;box-shadow:0 2px 10px rgba(20,18,40,.14)}
.spdp-gnav:hover{background:#fff;border-color:var(--cda-accent);color:var(--cda-accent-d)}
.spdp-gnav-l{left:10px}.spdp-gnav-r{right:10px}

/* hero card + free shipping + tighter mobile */
.spdp-herocard{border:2px solid #111129;border-radius:20px;padding:20px 18px;background:#fff}
.spdp-fs{margin-top:16px}
.spdp-fs-bar{height:8px;border-radius:999px;background:#e7e8ef;overflow:hidden}
.spdp-fs-fill{height:100%;width:0;background:linear-gradient(90deg,#98A3DE,#6D49E0,#98A3DE);background-size:200% 100%;animation:spdpfsmove 1.8s linear infinite;box-shadow:0 0 8px rgba(152,163,222,.75);transition:width .5s}
@keyframes spdpfsmove{0%{background-position:0 0}100%{background-position:200% 0}}
.spdp-fs-txt{font-size:.8rem;font-weight:700;color:var(--cda-ink);margin-top:7px;text-align:center}
@media(max-width:768px){
.spdp-herocard{padding:15px 13px;border-radius:18px}
.spdp-grid{gap:16px}
.spdp-kick{margin:9px 0 4px}
.spdp-h1{font-size:1.5rem;margin-bottom:8px}
.spdp-sub{font-size:.94rem;margin-bottom:12px}
.spdp-pills{margin-bottom:13px}
.spdp-card{padding:13px;margin-bottom:14px}
.spdp-sets{margin-bottom:14px}
.spdp-opts{gap:10px;margin-bottom:14px}
.spdp-thumbs{gap:6px}
}
/* hide qty pricing + sticky mobile cart */
.spdp-set-p{display:none}
.spdp-sticky{display:none}
@media(max-width:768px){
.spdp-sticky{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:999;background:#111129;align-items:center;gap:11px;padding:9px 13px;box-shadow:0 -4px 18px rgba(0,0,0,.22)}
.spdp-sticky-cart{position:relative;width:46px;height:46px;border-radius:12px;border:1px solid rgba(255,255,255,.25);background:transparent;display:flex;align-items:center;justify-content:center;flex:0 0 auto;cursor:pointer}
.spdp-sticky-badge{position:absolute;top:-5px;right:-5px;min-width:18px;height:18px;border-radius:999px;background:#98A3DE;color:#111129;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;padding:0 4px;line-height:1}
.spdp-sticky-price{color:#fff;font-weight:800;font-size:1.05rem;white-space:nowrap}
.spdp-sticky-cta{flex:1;background:#98A3DE;color:#111129;border:none;border-radius:12px;padding:14px;font-size:1rem;font-weight:800;cursor:pointer}
body{padding-bottom:76px}
}

/* bundle options */
.spdp-pop{margin-left:auto;background:#98A3DE;color:#111129;font-size:.6rem;font-weight:800;letter-spacing:.06em;padding:3px 8px;border-radius:999px}
.spdp-opt-desc{display:block;font-size:.9rem;color:var(--cda-muted);margin:3px 0 2px}
.spdp-savepill{background:#d8f3e3;color:#1b8a5a;font-size:.7rem;font-weight:800;padding:2px 8px;border-radius:999px;margin-left:6px;vertical-align:1px}
.spdp-today{font-size:.85rem;font-weight:600;color:var(--cda-muted)}
.spdp-opt-renew{display:block;font-size:.82rem;color:var(--cda-muted);font-weight:600;margin:0 0 4px}
.spdp-opt-fine{display:block;font-size:.72rem;color:var(--cda-muted);margin-top:9px;line-height:1.35;border-top:1px solid var(--cda-line);padding-top:8px}

/* IM8 sticky dropdown */
.spdp-sticky-sel{flex:1;min-width:0;display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.22);border-radius:12px;padding:7px 12px;cursor:pointer;text-align:left}
.spdp-sticky-txt{display:flex;flex-direction:column;min-width:0;line-height:1.15}
.spdp-sticky-name{font-size:.82rem;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.spdp-sticky-price{font-size:.74rem;font-weight:600;color:rgba(255,255,255,.75)}
.spdp-sticky-car{margin-left:auto;color:rgba(255,255,255,.8);font-size:.85rem;flex:0 0 auto}
.spdp-sticky-cta{flex:0 0 auto;min-height:52px;background:#98A3DE;color:#fff;border:none;border-radius:14px;padding:0 22px;font-size:1rem;font-weight:800;cursor:pointer;white-space:nowrap}
.spdp-sticky-menu{display:none;position:absolute;left:13px;right:13px;bottom:calc(100% + 8px);background:#fff;border-radius:14px;box-shadow:0 -8px 30px rgba(0,0,0,.28);overflow:hidden;border:1px solid rgba(17,17,41,.1)}
.spdp-sticky-menu.open{display:block}
.spdp-smenu-i{display:block;width:100%;text-align:left;background:none;border:none;border-bottom:1px solid rgba(17,17,41,.08);padding:15px 16px;font-size:.95rem;font-weight:700;color:#111129;cursor:pointer;font-family:inherit}
.spdp-smenu-i:last-child{border-bottom:none}
.spdp-smenu-i:active{background:var(--cda-soft)}

/* mobile cleanup final */
.spdp-main{border:1px solid #E5E7EB;border-radius:12px;overflow:hidden;background:#fff;position:relative}
.spdp-hbadge{position:absolute;top:10px;right:10px;z-index:5;background:#98A3DE;color:#111129;font-size:.64rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:5px 11px;border-radius:999px;box-shadow:0 2px 8px rgba(20,18,40,.16)}
.spdp-opt{background:#fff;border:1px solid #E5E7EB}
.spdp-opt.sel{border:2px solid #98A3DE;background:#F4F5FB;box-shadow:0 4px 16px rgba(152,163,222,.22)}
.spdp-thumbs button.sel{box-shadow:0 0 0 2px #111129}
@media(max-width:768px){
.spdp-main img{max-height:58vh;object-fit:contain}
.spdp-herocard{padding:13px 12px}
.spdp-opts{gap:9px}
.spdp-opt{padding:13px}
.spdp-card{padding:12px;margin-bottom:12px}
.spdp-pills{margin-bottom:11px}
.spdp-h1{font-size:1.45rem}
}
</style>
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');if(!root)return;
  var opts=root.querySelectorAll('[data-bundle]');
  var ctaPrice=root.querySelector('[data-spdp-cta-price]'),btn=document.getElementById('{{ fid }}-cta');
  function money(n){return '$'+(Math.round(n*100)/100).toFixed(2).replace(/\.00$/,'');}
  function curOpt(){return root.querySelector('[data-bundle].sel')||opts[0];}
  function priceFor(o){var base=parseFloat(o.getAttribute('data-base'))||0;var pct=parseFloat(o.getAttribute('data-pct'))||0;return base*(1-pct/100);}
  function render(){opts.forEach(function(o){var pe=o.querySelector('[data-price]');if(!pe)return;var base=parseFloat(o.getAttribute('data-base'))||0;var hasR=!!o.querySelector('.spdp-opt-renew');pe.innerHTML=money(base)+(hasR?' <span class="spdp-today">today</span>':'');});var o=curOpt(),pr=parseFloat(o.getAttribute('data-base'))||0;var im=o.getAttribute('data-img');if(im){var bg=document.querySelector('#{{ fid }}-main img');if(bg)bg.src=im;}var isSub=(o.getAttribute('data-items')||'').indexOf('|')>-1;if(ctaPrice)ctaPrice.textContent=money(pr);if(btn)btn.textContent=(isSub?'Subscribe & Save · ':'Add to cart · ')+money(pr);var sp=root.querySelector('[data-spsb-stickyprice]');if(sp)sp.textContent=money(pr);var sn=root.querySelector('[data-spsb-stickyname]');if(sn)sn.textContent=o.getAttribute('data-name')||'';var scl=document.getElementById('{{ fid }}-stickycta');if(scl)scl.textContent=(isSub?'SUBSCRIBE & SAVE':'ADD TO CART');}
  opts.forEach(function(o){o.addEventListener('click',function(e){e.preventDefault();opts.forEach(function(x){x.classList.remove('sel');});o.classList.add('sel');render();});});
  root.querySelectorAll('[data-spdp-thumb]').forEach(function(t){t.addEventListener('click',function(){var big=document.querySelector('#{{ fid }}-main img');if(big)big.src=t.getAttribute('data-spdp-thumb');});});
  var trow=document.getElementById('{{ fid }}-trow'),tprev=root.querySelector('[data-spdp-tprev]'),tnext=root.querySelector('[data-spdp-tnext]');
  function tscroll(dir){if(!trow)return;var card=trow.querySelector('.spdp-tcard');var w=card?card.getBoundingClientRect().width+14:200;trow.scrollBy({left:dir*w,behavior:'smooth'});}
  if(tprev)tprev.addEventListener('click',function(){tscroll(-1);});
  if(tnext)tnext.addEventListener('click',function(){tscroll(1);});
  var ssel=root.querySelector('[data-spsb-stickysel]'),smenu=root.querySelector('[data-spsb-stickymenu]');
  if(ssel&&smenu){opts.forEach(function(o,i){if((o.getAttribute('data-items')||'').indexOf('|')===-1){return;}var mi=document.createElement('button');mi.type='button';mi.className='spdp-smenu-i';mi.textContent=(o.getAttribute('data-name')||('Option '+(i+1)));mi.addEventListener('click',function(e){e.preventDefault();opts.forEach(function(x){x.classList.remove('sel');});o.classList.add('sel');render();smenu.classList.remove('open');});smenu.appendChild(mi);});ssel.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();smenu.classList.toggle('open');});document.addEventListener('click',function(e){if(ssel.contains(e.target)||smenu.contains(e.target))return;smenu.classList.remove('open');});}
  render();
})();
</script>
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');if(!root)return;
  var box=document.getElementById('{{ fid }}-main');var main=box?box.querySelector('img'):null;
  var th=[].slice.call(root.querySelectorAll('[data-spsb-thumb],[data-spdp-thumb]'));
  var navs=root.querySelectorAll('.spdp-gnav');
  if(!main||th.length<2){for(var k=0;k<navs.length;k++)navs[k].style.display='none';return;}
  var urls=th.map(function(t){return t.getAttribute('data-spsb-thumb')||t.getAttribute('data-spdp-thumb');});
  var idx=0;
  function setA(){th.forEach(function(t,j){t.classList.toggle('sel',j===idx);});}
  function show(i){idx=(i+urls.length)%urls.length;main.src=urls[idx];setA();}
  th.forEach(function(t,i){t.addEventListener('click',function(){idx=i;setA();});});
  var pa=root.querySelector('[data-gprev]'),na=root.querySelector('[data-gnext]');
  if(pa)pa.addEventListener('click',function(e){e.preventDefault();show(idx-1);});
  if(na)na.addEventListener('click',function(e){e.preventDefault();show(idx+1);});
  var sx=null;
  box.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
  box.addEventListener('touchend',function(e){if(sx==null)return;var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40)show(dx<0?idx+1:idx-1);sx=null;},{passive:true});
  setA();
})();
</script>
<script>
(function(){
  var r=document.getElementById('shopify-section-{{ section.id }}');if(!r)return;
  var fill=r.querySelector('[data-spdp-fsfill]'),txt=r.querySelector('[data-spdp-fstxt]');if(!fill)return;var TH=5000;
  fetch('/cart.js').then(function(x){return x.json();}).then(function(c){var t=c.total_price||0;var bdg=r.querySelector('[data-spsb-cartcount]');if(bdg)bdg.textContent=c.item_count||0;var pct=Math.min(100,Math.round(t/TH*100));if(t<TH){pct=Math.max(6,pct);}fill.style.width=pct+'%';if(t>=TH){txt.textContent='You have unlocked free shipping';}else{txt.textContent='You are $'+((TH-t)/100).toFixed(2)+' away from free shipping';}}).catch(function(){fill.style.width='0%';});
})();
</script>
