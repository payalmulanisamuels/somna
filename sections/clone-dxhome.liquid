{{ 'clone-dreamx-alarm-styles.css' | asset_url | stylesheet_tag }}
{%- assign pA = all_products['silent-alarm-band'] -%}{%- assign pN = all_products['anti-snore-nasal-strips'] -%}{%- assign pT = all_products['sleep-mouth-tape'] -%}
{%- assign vA = pA.selected_or_first_available_variant -%}{%- assign vN = pN.selected_or_first_available_variant -%}{%- assign vT = pT.selected_or_first_available_variant -%}
<div class="dxh">

  {%- comment -%} ===== HERO ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec">
    <div class="dxh-hero">
      {% if section.settings.hero_image != blank %}<img class="dxh-hero-bg dxh-hero-bg-d" src="{{ section.settings.hero_image | image_url: width: 2200 }}" alt="" loading="eager">{% endif %}
      {% if section.settings.hero_image_mobile != blank %}<img class="dxh-hero-bg dxh-hero-bg-m" style="object-position:{{ section.settings.hero_focus_mobile | default: '50% 50%' }}" src="{{ section.settings.hero_image_mobile | image_url: width: 1200 }}" alt="" loading="eager">{% elsif section.settings.hero_image != blank %}<img class="dxh-hero-bg dxh-hero-bg-m" style="object-position:{{ section.settings.hero_focus_mobile | default: '50% 50%' }}" src="{{ section.settings.hero_image | image_url: width: 1600 }}" alt="" loading="eager">{% endif %}
      <div class="dxh-hero-in">
        <span class="dxh-kick">{{ section.settings.hero_kicker }}</span>
        <h1 class="dxh-h1"><span class="dxh-h1a">{{ section.settings.hero_line1 }}</span><span class="dxh-h1b">{{ section.settings.hero_line2 }}</span></h1>
        {% if section.settings.hero_proof != blank %}<div class="dxh-hero-proof"> <span>{{ section.settings.hero_proof }}</span></div>{% endif %}
        <a class="cda-btn dxh-btn" href="{{ section.settings.hero_cta_link | default: '/collections/all' }}">{{ section.settings.hero_cta }}</a>
      </div>
    </div>
  </section>

  {% if section.settings.enable_seen_logos %}
  {%- comment -%} ===== AS SEEN IN ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-seenbar">
    <div class="dxh-seen-k">AS SEEN IN</div>
    <div class="dxh-marquee"><div class="dxh-marquee-t">
      {%- assign seen = section.settings.seen_logos | split: ',' -%}
      {%- for l in seen -%}<span>{{ l | strip }}</span>{%- endfor -%}
      {%- for l in seen -%}<span>{{ l | strip }}</span>{%- endfor -%}
    </div></div>
  </section>
{%  endif %}

  {%- comment -%} ===== PROBLEM STATEMENT ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec">
    <div class="dxh-center"><h2 class="dxh-h2">{{ section.settings.prob_head }}</h2><p class="dxh-muted" style="margin-top:10px">{{ section.settings.prob_body }}</p></div>
    <div class="dxh-grid3">
      <div class="dxh-prob"><div class="dxh-ic">{{ section.settings.prob1_ic }}</div><div class="dxh-pn">{{ section.settings.prob1_t }}</div><p class="dxh-muted2">{{ section.settings.prob1_d }}</p></div>
      <div class="dxh-prob"><div class="dxh-ic">{{ section.settings.prob2_ic }}</div><div class="dxh-pn">{{ section.settings.prob2_t }}</div><p class="dxh-muted2">{{ section.settings.prob2_d }}</p></div>
      <div class="dxh-prob"><div class="dxh-ic">{{ section.settings.prob3_ic }}</div><div class="dxh-pn">{{ section.settings.prob3_t }}</div><p class="dxh-muted2">{{ section.settings.prob3_d }}</p></div>
    </div>
    <p class="dxh-center dxh-probsub">{{ section.settings.prob_sub }}</p>
  </section>

  {%- comment -%} ===== BESTSELLERS ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec dxh-sec-bs">
    <h2 class="dxh-h2 dxh-center">Explore our bestsellers</h2>
    <div class="dxh-grid3 dxh-prodgrid">
      <div class="dxh-pcard dxh-pcard-rich">
        <a class="dxh-card-link" href="/products/anti-snore-nasal-strips"><span class="dxh-badge">Best Seller</span>{% if section.settings.img_best2 != blank %}<div class="cda-ph"><img src="{{ section.settings.img_best2 | image_url: width: 600 }}" alt="{{ section.settings.img_best2.alt }}" width="600" height="600" loading="lazy"></div>{% elsif pN.featured_image %}<div class="cda-ph"><img src="{{ pN.featured_image | image_url: width: 600 }}" alt="{{ pN.title }}" width="600" height="600" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %} <div class="dxh-pn">Anti-Snore Nasal Strips</div><div class="dxh-bene">{{ section.settings.best2_bene }}</div><p class="dxh-muted2">{{ section.settings.best2_desc }}</p><div class="dxh-pp">$24 <s>$40</s></div><span class="dxh-gtee">{{ section.settings.card_gtee2 }}</span></a>
        <button type="button" class="dxh-shop" data-vid="{{ vN.id }}">Add to cart</button>
      </div>

      <div class="dxh-pcard dxh-pcard-rich">
        <a class="dxh-card-link" href="/products/sleep-mouth-tape"><span class="dxh-badge">Most Popular</span>{% if section.settings.img_best3 != blank %}<div class="cda-ph"><img src="{{ section.settings.img_best3 | image_url: width: 600 }}" alt="{{ section.settings.img_best3.alt }}" width="600" height="600" loading="lazy"></div>{% elsif pT.featured_image %}<div class="cda-ph"><img src="{{ pT.featured_image | image_url: width: 600 }}" alt="{{ pT.title }}" width="600" height="600" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %}<div class="dxh-pn">Sleep Mouth Tape</div><div class="dxh-bene">{{ section.settings.best3_bene }}</div><p class="dxh-muted2">{{ section.settings.best3_desc }}</p><div class="dxh-pp">$19 <s>$32</s></div><span class="dxh-gtee">{{ section.settings.card_gtee3 }}</span></a>
        <button type="button" class="dxh-shop" data-vid="{{ vT.id }}">Add to cart</button>
      </div>

      <div class="dxh-pcard dxh-pcard-rich">
        <a class="dxh-card-link" href="/products/silent-alarm-band"><span class="dxh-badge">Bundle</span>{% if section.settings.img_best1 != blank %}<div class="cda-ph"><img src="{{ section.settings.img_best1 | image_url: width: 600 }}" alt="{{ section.settings.img_best1.alt }}" width="600" height="600" loading="lazy"></div>{% elsif section.settings.img_kit != blank %}<div class="cda-ph"><img src="{{ section.settings.img_kit | image_url: width: 600 }}" alt="{{ section.settings.img_kit.alt }}" width="600" height="600" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %}<div class="dxh-pn">Complete Sleep System</div><div class="dxh-bene">{{ section.settings.kit_bene }}</div><p class="dxh-muted2">{{ section.settings.kit_desc }}</p><div class="dxh-pp">$69 <s>$137</s></div><span class="dxh-gtee">{{ section.settings.card_gtee1 }}</span></a>
        <button type="button" class="dxh-shop" data-vid="{{ vA.id }}">Get the system</button>
      </div>
    </div>
  </section>

  {%- comment -%} ===== WHY CHOOSE SOMNA ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec">
    <h2 class="dxh-h2 dxh-center">{{ section.settings.why_head }}</h2>
    <div class="dxh-grid3" style="margin-top:24px">
      <div class="dxh-cmp"><h3 class="dxh-cmp-h">{{ section.settings.why1_h }}</h3>{{ section.settings.why1_list }}</div>
      <div class="dxh-cmp"><h3 class="dxh-cmp-h">{{ section.settings.why2_h }}</h3>{{ section.settings.why2_list }}</div>
      <div class="dxh-cmp"><h3 class="dxh-cmp-h">{{ section.settings.why3_h }}</h3>{{ section.settings.why3_list }}</div>
    </div>
  </section>

  {%- comment -%} ===== WHICH SLEEP PROBLEM ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec">
    <div class="dxh-center"><h2 class="dxh-h2">{{ section.settings.fit_head }}</h2><p class="dxh-muted" style="margin-top:8px">{{ section.settings.fit_sub }}</p></div>
    <div class="dxh-grid4">
      <a class="dxh-solve" href="{{ section.settings.fit1_link | default: '/collections/all' }}"><div class="dxh-pn">{{ section.settings.fit1_t }}</div><p class="dxh-muted2">{{ section.settings.fit1_s }}</p><div class="dxh-solve-x">{{ section.settings.fit1_sol }}</div></a>
      <a class="dxh-solve" href="{{ section.settings.fit2_link | default: '/products/anti-snore-nasal-strips' }}"><div class="dxh-pn">{{ section.settings.fit2_t }}</div><p class="dxh-muted2">{{ section.settings.fit2_s }}</p><div class="dxh-solve-x">{{ section.settings.fit2_sol }}</div></a>
      <a class="dxh-solve" href="{{ section.settings.fit3_link | default: '/products/sleep-mouth-tape' }}"><div class="dxh-pn">{{ section.settings.fit3_t }}</div><p class="dxh-muted2">{{ section.settings.fit3_s }}</p><div class="dxh-solve-x">{{ section.settings.fit3_sol }}</div></a>
      <a class="dxh-solve" href="{{ section.settings.fit4_link | default: '/collections/all' }}"><div class="dxh-pn">{{ section.settings.fit4_t }}</div><p class="dxh-muted2">{{ section.settings.fit4_s }}</p><div class="dxh-solve-x">{{ section.settings.fit4_sol }}</div></a>
    </div>
  </section>

  {%- comment -%} ===== HOW IT WORKS ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec" id="how">
    <div class="dxh-center"><h2 class="dxh-h2">{{ section.settings.how_head }}</h2><p class="dxh-muted" style="margin-top:8px">{{ section.settings.how_sub }}</p></div>
    <div class="dxh-steps">
      <div class="dxh-step"><div class="dxh-step-n">1</div><div class="dxh-pn">{{ section.settings.how1_t }}</div><p class="dxh-muted2">{{ section.settings.how1_d }}</p></div>
      <div class="dxh-step"><div class="dxh-step-n">2</div><div class="dxh-pn">{{ section.settings.how2_t }}</div><p class="dxh-muted2">{{ section.settings.how2_d }}</p></div>
      <div class="dxh-step"><div class="dxh-step-n">3</div><div class="dxh-pn">{{ section.settings.how3_t }}</div><p class="dxh-muted2">{{ section.settings.how3_d }}</p></div>
      <div class="dxh-step"><div class="dxh-step-n">4</div><div class="dxh-pn">{{ section.settings.how4_t }}</div><p class="dxh-muted2">{{ section.settings.how4_d }}</p></div>
    </div>
    <p class="dxh-center dxh-probsub">{{ section.settings.how_foot }}</p>
  </section>

  {% if section.settings.stat1_n != blank or  section.settings.stat2_n != blank or section.settings.stat3_n != blank %}
  {%- comment -%} ===== STATS ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec">
    <div class="dxh-band">
      <h2 class="dxh-h2" style="color:#fff">{{ section.settings.stat_head }}</h2>
      <p style="color:#cabff2;max-width:52ch;margin:8px auto 0">{{ section.settings.stat_sub }}</p>
      <div class="dxh-stats3">
        <div><div class="dxh-big">{{ section.settings.stat1_n }}</div><div class="dxh-ss">{{ section.settings.stat1_l }}</div><div class="dxh-src">{{ section.settings.stat1_src }}</div></div>
        <div><div class="dxh-big">{{ section.settings.stat2_n }}</div><div class="dxh-ss">{{ section.settings.stat2_l }}</div><div class="dxh-src">{{ section.settings.stat2_src }}</div></div>
        <div><div class="dxh-big">{{ section.settings.stat3_n }}</div><div class="dxh-ss">{{ section.settings.stat3_l }}</div><div class="dxh-src">{{ section.settings.stat3_src }}</div></div>
      </div>
      <p class="dxh-disc">{{ section.settings.stat_disc }}</p>
    </div>
  </section>
  {% endif %}

  {% if section.settings.enable_review %}
  {%- comment -%} ===== EXPERTS ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec">
    <div class="dxh-center"><div class="dxh-stars">★★★★★</div><h2 class="dxh-h2">{{ section.settings.exp_head }}</h2></div>
    <div class="dxh-grid3">
      {%- for i in (1..3) -%}
        {%- assign qk = 'exp' | append: i | append: '_q' -%}{%- assign nk = 'exp' | append: i | append: '_name' -%}{%- assign rk = 'exp' | append: i | append: '_role' -%}{%- assign ik = 'img_exp' | append: i -%}
        <div class="dxh-rcard"><p class="dxh-q">{{ section.settings[qk] }}</p><div class="dxh-who">{% if section.settings[ik] != blank %}<div class="cda-ph round" style="width:42px;height:42px"><img src="{{ section.settings[ik] | image_url: width: 120 }}" alt="" width="120" height="120"></div>{% else %}<div class="cda-ph round" style="width:42px;height:42px"></div>{% endif %}<div><div class="dxh-pn">{{ section.settings[nk] }}</div><div class="dxh-muted2">{{ section.settings[rk] }}</div></div></div></div>
      {%- endfor -%}
    </div>
  </section>
  {% endif %}

  {%- comment -%} ===== BUNDLES ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec">
    <h2 class="dxh-h2 dxh-center">Save on our bundles</h2>
    <div class="dxh-grid3 dxh-prodgrid">
      <div class="dxh-pcard">
        <a class="dxh-card-link" href="/products/silent-alarm-band"><span class="dxh-save">SAVE 55%</span>{% if section.settings.img_save1 != blank %}<div class="cda-ph"><img src="{{ section.settings.img_save1 | image_url: width: 600 }}" alt="{{section.settings.img_save1.alt}}" width="600" height="600" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %}<div class="dxh-pn">Couple’s Favorite</div><div class="dxh-pp">$90 <s>$178</s></div></a>
        <button type="button" class="dxh-shop" data-vid="{{ vA.id }}">Add to cart</button>
      </div>
      <div class="dxh-pcard">
        <a class="dxh-card-link" href="/products/silent-alarm-band"><span class="dxh-save">SAVE 49%</span>{% if section.settings.img_save2 != blank %}<div class="cda-ph"><img src="{{ section.settings.img_save2 | image_url: width: 600 }}" alt="{{section.settings.img_save2.alt}}" width="600" height="600" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %}<div class="dxh-pn">Perfect Sleep Kit</div><div class="dxh-pp">$69 <s>$137</s></div></a>
        <button type="button" class="dxh-shop" data-vid="{{ vA.id }}">Add to cart</button>
      </div>
      <div class="dxh-pcard">
        <a class="dxh-card-link" href="/products/silent-alarm-band"><span class="dxh-save">SAVE 60%</span>{% if section.settings.img_save4 != blank %}<div class="cda-ph"><img src="{{ section.settings.img_save4 | image_url: width: 600 }}" alt="{{section.settings.img_save4.alt}}" width="600" height="600" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %}<div class="dxh-pn">Family 4-Pack</div><div class="dxh-pp">$136 <s>$356</s></div></a>
        <button type="button" class="dxh-shop" data-vid="{{ vA.id }}">Add to cart</button>
      </div>
    </div>
  </section>

  {%- comment -%} ===== FAQ ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec" style="max-width:840px">
    <h2 class="dxh-h2 dxh-center">{{ section.settings.faq_head }}</h2>
    {% if section.settings.faq_sub != blank %}<p class="dxh-muted dxh-center" style="margin:8px auto 26px;max-width:520px">{{ section.settings.faq_sub }}</p>{% endif %}
    <div class="dxh-faq">
      {%- for i in (1..12) -%}{%- assign qk = 'faq_q' | append: i -%}{%- assign ak = 'faq_a' | append: i -%}{% if section.settings[qk] != blank %}<details class="dxh-faqr"><summary>{{ section.settings[qk] }}<span class="dxh-faqic">+</span></summary><div class="dxh-faqa">{{ section.settings[ak] }}</div></details>{% endif %}{%- endfor -%}
    </div>
  </section>

  {%- comment -%} ===== COMPLIANCE / TRUST ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec">
    <h2 class="dxh-h2 dxh-center">{{ section.settings.trust_head }}</h2>
    <div class="dxh-grid3" style="margin-top:24px">
      <div class="dxh-cmp"><h3 class="dxh-cmp-h">{{ section.settings.trust1_h }}</h3>{{ section.settings.trust1_list }}</div>
      <div class="dxh-cmp"><h3 class="dxh-cmp-h">{{ section.settings.trust2_h }}</h3>{{ section.settings.trust2_list }}</div>
      <div class="dxh-cmp"><h3 class="dxh-cmp-h">{{ section.settings.trust3_h }}</h3>{{ section.settings.trust3_list }}</div>
    </div>
    <p class="dxh-disc dxh-disc-light">{{ section.settings.trust_disc }}</p>
  </section>

  {%- comment -%} ===== JOURNAL ===== {%- endcomment -%}
  <section class="dxh-wrap dxh-sec">
    <h2 class="dxh-h2">From the journal</h2>
    <div class="dxh-grid3" style="margin-top:24px">
      <a class="dxh-jcard" href="{{ section.settings.jour1_url | default: '/pages/the-science' }}">{% if section.settings.img_jour1 != blank %}<div class="cda-ph"><img src="{{ section.settings.img_jour1 | image_url: width: 700 }}" alt="" width="700" height="700" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %}<div class="dxh-pn" style="margin-top:12px">{{ section.settings.jour1_title }}</div><p class="dxh-muted2">{{ section.settings.jour1_desc }}</p></a>
      <a class="dxh-jcard" href="{{ section.settings.jour2_url | default: '/pages/the-science' }}">{% if section.settings.img_jour2 != blank %}<div class="cda-ph"><img src="{{ section.settings.img_jour2 | image_url: width: 700 }}" alt="" width="700" height="700" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %}<div class="dxh-pn" style="margin-top:12px">{{ section.settings.jour2_title }}</div><p class="dxh-muted2">{{ section.settings.jour2_desc }}</p></a>
      <a class="dxh-jcard" href="{{ section.settings.jour3_url | default: '/pages/the-science' }}">{% if section.settings.img_jour3 != blank %}<div class="cda-ph"><img src="{{ section.settings.img_jour3 | image_url: width: 700 }}" alt="" width="700" height="700" loading="lazy"></div>{% else %}<div class="cda-ph" data-label="1:1"></div>{% endif %}<div class="dxh-pn" style="margin-top:12px">{{ section.settings.jour3_title }}</div><p class="dxh-muted2">{{ section.settings.jour3_desc }}</p></a>
    </div>
  </section>

  {%- comment -%} ===== NEWSLETTER ===== {%- endcomment -%}
  <section class="dxh-news">
    <div class="dxh-wrap dxh-news-in">
      <div><h2 class="dxh-h2" style="color:#fff">{{ section.settings.news_head }}</h2><p style="color:#eef0fb">{{ section.settings.news_sub }}</p></div>
      <form class="dxh-form" onsubmit="return false"><input type="email" placeholder="you@email.com" aria-label="Email"><button class="dxh-sub">{{ section.settings.news_btn }}</button></form>
    </div>
  </section>

</div>
<style>
.dxh{font-family:var(--cda-font);color:var(--cda-ink);background:#fbfbff;--cda-accent:#98A3DE;--cda-accent-d:#6f7cc4;--cda-soft:#eef0fb}
.dxh-wrap{max-width:1120px;margin:0 auto;padding:0 clamp(16px,4vw,24px)}
.dxh-sec{padding:clamp(30px,5vw,48px) 0}
.dxh-seenbar{padding:14px 0 4px}
.dxh-sec-bs{padding-top:18px}
.dxh-h1{font-size:clamp(2.4rem,6vw,4.2rem);font-weight:900;line-height:.98;letter-spacing:-.03em;color:#fff;margin:12px 0 14px;text-transform:uppercase;text-shadow:0 2px 24px rgba(0,0,0,.5)}
.dxh-h1a{display:block}
.dxh-h1b{display:block;color:var(--cda-accent);font-size:1.12em}
.dxh-h2{font-size:clamp(1.5rem,3.2vw,2.2rem);font-weight:800;letter-spacing:-.02em;margin:0}
.dxh-h2 em{color:var(--cda-accent);font-style:italic}
.dxh-center{text-align:center;max-width:720px;margin:0 auto 24px}
.dxh-muted{color:var(--cda-muted)}
.dxh-muted2{color:var(--cda-muted);font-size:.88rem;margin:4px 0 0}
.dxh-kick{display:inline-block;text-transform:uppercase;letter-spacing:.14em;font-size:.74rem;font-weight:800;color:#fff;text-shadow:0 1px 10px rgba(0,0,0,.4)}
.dxh-stars{color:#34c759;letter-spacing:2px}
.dxh-btn{max-width:230px;background:var(--cda-accent);border:none;box-shadow:0 4px 14px rgba(15,13,26,.25);min-height:48px;display:flex;align-items:center;justify-content:center}
.dxh-hero{position:relative;background:#1a1726;border-radius:22px;padding:clamp(28px,5vw,56px);min-height:clamp(480px,58vw,640px);display:flex;align-items:flex-end;overflow:hidden;isolation:isolate}
.dxh-hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:0}
.dxh-hero-bg-m{display:none}
.dxh-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(13,11,24,.9),rgba(13,11,24,.42) 46%,rgba(13,11,24,.08));z-index:1}
.dxh-hero-in{position:relative;z-index:2;max-width:620px}
.dxh-hero-proof{display:flex;align-items:center;gap:9px;color:#fff;font-weight:600;margin:0 0 22px;text-shadow:0 1px 12px rgba(0,0,0,.45)}
.dxh-hero-stars{color:#34c759;letter-spacing:2px}
.dxh-grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.dxh-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.dxh-grid2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.dxh-pcard{display:flex;flex-direction:column;border:1px solid var(--cda-line);border-radius:18px;padding:12px;color:inherit;background:#fff;transition:.18s;position:relative;box-shadow:0 6px 22px rgba(20,18,40,.05)}
.dxh-pcard:hover{box-shadow:0 16px 36px rgba(152,163,222,.22);transform:translateY(-4px)}
.dxh-card-link{display:block;text-decoration:none;color:inherit;flex:1}
.dxh-pcard .cda-ph{margin-bottom:10px;border-radius:12px;overflow:hidden}
.dxh-pcard-rich{padding:14px}
.dxh-rate{display:flex;align-items:center;gap:6px;font-size:.85rem;margin-bottom:4px}
.dxh-rate .dxh-stars{color:#f5a623}
.dxh-rate strong{font-weight:800}
.dxh-rc{color:var(--cda-muted)}
.dxh-pn{font-weight:700;font-size:.98rem;letter-spacing:-.01em}
.dxh-bene{color:var(--cda-accent-d);font-weight:700;font-size:.92rem;margin:3px 0 4px}
.dxh-pp{font-weight:800;color:var(--cda-ink);margin-top:8px;font-size:1.08rem}
.dxh-pp s{color:var(--cda-muted);font-weight:500;font-size:.85rem;margin-left:4px}
.dxh-gtee{display:block;font-size:.74rem;color:var(--cda-muted);margin:6px 0 0}
.dxh-shop{display:flex;align-items:center;justify-content:center;text-align:center;margin-top:12px;background:var(--cda-accent);color:#fff;border:none;border-radius:999px;padding:12px;font-weight:700;font-size:.9rem;min-height:44px;width:100%;cursor:pointer;font-family:inherit;transition:background .15s}
.dxh-shop:hover{background:var(--cda-accent-d)}
.dxh-badge{position:absolute;top:12px;left:12px;z-index:1;background:var(--cda-ink);color:#fff;font-size:.64rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;padding:4px 9px;border-radius:999px}
.dxh-save{position:absolute;top:10px;left:10px;background:#1b8a5a;color:#fff;font-size:.64rem;font-weight:700;padding:3px 8px;border-radius:999px;z-index:1}
.dxh-prob{background:#fff;border:1px solid var(--cda-line);border-radius:16px;padding:24px;text-align:center;box-shadow:0 6px 22px rgba(20,18,40,.04)}
.dxh-probsub{margin-top:22px;font-weight:700;color:var(--cda-accent-d)}
.dxh-ic{font-size:1.8rem;margin-bottom:8px}
.dxh-cmp{background:#fff;border:1px solid var(--cda-line);border-radius:16px;padding:24px;box-shadow:0 6px 22px rgba(20,18,40,.04)}
.dxh-cmp-h{font-size:1.05rem;font-weight:800;margin:0 0 14px;letter-spacing:-.01em}
.dxh-cmp ul{list-style:none;margin:0;padding:0}
.dxh-cmp li{position:relative;padding:0 0 10px 26px;color:var(--cda-ink);font-size:.92rem;line-height:1.45}
.dxh-cmp li::before{content:'✓';position:absolute;left:0;top:0;color:var(--cda-accent-d);font-weight:800}
.dxh-cmp p{margin:0 0 10px}
.dxh-solve{display:block;background:#faf9ff;border:1px solid var(--cda-line);border-radius:16px;padding:20px;text-decoration:none;color:inherit;transition:.18s}
.dxh-solve:hover{border-color:var(--cda-accent);box-shadow:0 12px 28px rgba(152,163,222,.2);transform:translateY(-3px)}
.dxh-solve-x{margin-top:12px;padding-top:12px;border-top:1px solid var(--cda-line);font-size:.85rem;font-weight:700;color:var(--cda-accent-d)}
.dxh-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;counter-reset:s}
.dxh-step{background:#fff;border:1px solid var(--cda-line);border-radius:16px;padding:24px;position:relative}
.dxh-step-n{width:34px;height:34px;border-radius:50%;background:var(--cda-accent);color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.dxh-band{background:linear-gradient(150deg,#1a1726,#3a3f78);border-radius:24px;padding:clamp(30px,5vw,52px);color:#fff;text-align:center}
.dxh-stats3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:24px}
.dxh-big{font-size:clamp(2.2rem,5vw,3.2rem);font-weight:800;color:#fff}
.dxh-ss{color:#e7e9f6;font-size:.92rem;margin-top:4px}
.dxh-src{color:#a9aedb;font-size:.74rem;margin-top:8px;line-height:1.4}
.dxh-disc{color:#a9aedb;font-size:.72rem;line-height:1.5;max-width:70ch;margin:24px auto 0;text-align:center}
.dxh-disc-light{color:var(--cda-muted)}
.dxh-tcard{background:#fff;border:1px solid var(--cda-line);border-radius:16px;padding:22px;box-shadow:0 6px 22px rgba(20,18,40,.05)}
.dxh-res{display:inline-block;background:var(--cda-soft);color:var(--cda-accent-d);font-weight:700;font-size:.8rem;padding:5px 11px;border-radius:999px;margin:0 0 14px}
.dxh-rcard{border:1px solid var(--cda-line);border-radius:16px;padding:22px;background:#fff}
.dxh-q{font-weight:500;margin:0 0 16px;line-height:1.5}
.dxh-who{display:flex;align-items:center;gap:12px}
.dxh-jcard{display:block;text-decoration:none;color:inherit}
.dxh-seen-k{text-align:center;text-transform:uppercase;letter-spacing:.2em;font-size:.72rem;font-weight:800;color:var(--cda-muted);margin-bottom:18px}
.dxh-marquee{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.dxh-marquee-t{display:flex;gap:52px;width:max-content;animation:dxhmar 28s linear infinite}
.dxh-marquee-t span{font-weight:800;letter-spacing:.06em;color:var(--cda-muted);opacity:.55;white-space:nowrap;font-size:1.1rem}
@keyframes dxhmar{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.dxh-faq{margin-top:6px;border-top:1px solid var(--cda-line)}
.dxh-faqr{border-bottom:1px solid var(--cda-line)}
.dxh-faqr summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 4px;cursor:pointer;font-weight:600;font-size:1rem}
.dxh-faqr summary::-webkit-details-marker{display:none}
.dxh-faqic{flex:0 0 auto;width:26px;height:26px;border-radius:50%;background:var(--cda-ink);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:600;line-height:1;transition:transform .2s}
.dxh-faqr[open] .dxh-faqic{transform:rotate(45deg)}
.dxh-faqa{padding:0 4px 22px;color:var(--cda-muted);line-height:1.55}
.dxh-news{background:var(--cda-accent);margin-top:30px}
.dxh-news-in{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:34px clamp(16px,4vw,24px);flex-wrap:wrap}
.dxh-form{display:flex;gap:10px;flex:1;max-width:440px;min-width:260px}
.dxh-form input{flex:1;border:none;border-radius:999px;padding:14px 18px;font:inherit}
.dxh-sub{background:#fff;color:var(--cda-accent-d);border:none;border-radius:999px;padding:14px 26px;font-weight:700;cursor:pointer}
@media(max-width:900px){.dxh-grid4{grid-template-columns:repeat(2,1fr)}.dxh-grid3{grid-template-columns:1fr}.dxh-stats3{grid-template-columns:1fr}.dxh-steps{grid-template-columns:1fr 1fr}}
@media(max-width:760px){
  .dxh-sec{padding:22px 0}
  .dxh-h2{font-size:1.4rem}
  .dxh-center{margin-bottom:16px}
  .dxh-prodgrid{grid-template-columns:1fr 1fr;gap:12px}
  .dxh-pcard{padding:10px;border-radius:14px}
  .dxh-pcard-rich{padding:12px}
  .dxh-pcard .cda-ph{margin-bottom:8px}
  .dxh-rate{font-size:.72rem;gap:4px;margin-bottom:2px}
  .dxh-pn{font-size:.86rem;line-height:1.2;margin-top:2px}
  .dxh-bene{font-size:.78rem}
  .dxh-pp{font-size:.92rem}
  .dxh-pp s{font-size:.74rem}
  .dxh-shop{padding:11px;font-size:.8rem;margin-top:8px}
  .dxh-save{font-size:.56rem;padding:2px 6px}
  .dxh-grid4{gap:12px}
  .dxh-prob,.dxh-cmp,.dxh-step,.dxh-tcard,.dxh-rcard{padding:18px}
  .dxh-band{padding:28px 20px}
  .dxh-big{font-size:2.1rem}
  .dxh-news{margin-top:18px}
  .dxh-news-in{padding:26px 16px}
  .dxh-marquee-t{gap:34px;animation-duration:22s}
  .dxh-marquee-t span{font-size:.95rem}
  .dxh-seen-k{margin-bottom:12px}
  .cda-btn.dxh-btn{padding:13px 22px;font-size:.95rem}
}
@media(max-width:560px){
  .dxh-grid2{grid-template-columns:1fr}
  .dxh-grid4{grid-template-columns:1fr 1fr}
  .dxh-steps{grid-template-columns:1fr}
  .dxh-news-in{flex-direction:column;align-items:flex-start}
  .dxh-hero{min-height:56vh;border-radius:18px;padding:24px 22px 26px;align-items:flex-end}
  .dxh-hero-bg-d{display:none}
  .dxh-hero-bg-m{display:block}
  .dxh-hero::after{background:linear-gradient(to top,rgba(12,10,22,.96) 5%,rgba(12,10,22,.62) 36%,rgba(12,10,22,.16) 64%,rgba(12,10,22,0) 86%)}
  .dxh-hero-in{max-width:100%}
  .dxh-kick{font-size:.7rem;letter-spacing:.16em}
  .dxh-h1{font-size:clamp(2.6rem,13vw,3.9rem);margin:5px 0 9px;line-height:.94}
  .dxh-h1b{font-size:1.2em}
  .dxh-hero-proof{margin:0 0 15px;font-size:.92rem}
  .dxh-btn{width:100%;max-width:none}
}
